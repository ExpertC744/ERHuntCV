@model ERHuntCV.Models.SAForgotPasswordModel

@{
    ViewData["Title"] = "Super Admin Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Super Admin Forgot Password</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          rel="stylesheet" />

    <!-- Existing Super Admin CSS -->
    <link rel="stylesheet"
          href="~/css/SALogin.css" />

</head>

<body>

    <div class="sa-login-page">

        <!-- Background Decoration -->

        <div class="bg-circle bg-circle-one"></div>
        <div class="bg-circle bg-circle-two"></div>


        <div class="sa-login-wrapper">

            <div class="sa-login-card">


                <!-- =================================================
                     BRAND
                ================================================== -->

                <div class="sa-login-brand">

                    <div class="sa-login-icon">

                        <i class="fas fa-user-shield"></i>

                    </div>

                    <h2>
                        Forgot Password
                    </h2>

                    <p>
                        Recover your Super Admin login details
                    </p>

                </div>


                <!-- =================================================
                     SECURITY
                ================================================== -->

                <div class="security-badge">

                    <i class="fas fa-lock"></i>

                    Secure Administrator Access

                </div>


                <!-- =================================================
                     SUCCESS MESSAGE
                ================================================== -->
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">

                        <i class="fas fa-circle-check me-2"></i>

                        @TempData["Success"]

                    </div>
                }


                <!-- =================================================
                     ERROR MESSAGE
                ================================================== -->
                @if (ViewBag.Error != null)
                {
                    <div class="login-error">

                        <i class="fas fa-circle-exclamation"></i>

                        <span>
                            @ViewBag.Error
                        </span>

                    </div>
                }


                <!-- =================================================
                     VALIDATION SUMMARY
                ================================================== -->

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <!-- =================================================
                     FORGOT PASSWORD FORM
                ================================================== -->

                <form asp-action="ForgotPassword"
                      asp-controller="SALogin"
                      method="post">

                    @Html.AntiForgeryToken()


                    <!-- EMAIL -->

                    <div class="sa-form-group">

                        <label asp-for="sEmail"
                               class="sa-form-label">

                            Registered Email Address

                        </label>


                        <div class="sa-input-wrapper">

                            <i class="fas fa-envelope sa-input-icon"></i>

                            <input asp-for="sEmail"
                                   class="sa-input"
                                   placeholder="Enter your registered email address"
                                   autocomplete="email" />

                        </div>


                        <span asp-validation-for="sEmail"
                              class="field-validation">
                        </span>

                    </div>


                    <!-- SEND LOGIN DETAILS -->

                    <button type="submit"
                            class="sa-login-button">

                        <i class="fas fa-paper-plane"></i>

                        <span>
                            Send Login Details
                        </span>

                    </button>


                    <!-- BACK TO LOGIN -->

                    <div class="text-center mt-3">

                        <a asp-controller="SALogin"
                           asp-action="Index"
                           class="text-decoration-none">

                            <i class="fas fa-arrow-left me-1"></i>

                            Back to Super Admin Login

                        </a>

                    </div>

                </form>


                <!-- =================================================
                     FOOTER
                ================================================== -->

                <div class="sa-login-footer">

                    <i class="fas fa-shield-halved"></i>

                    Authorized Super Admin Access Only

                </div>


            </div>

        </div>

    </div>


    <!-- =========================================================
         VALIDATION
    ========================================================= -->

    <partial name="_ValidationScriptsPartial" />

</body>

</html>