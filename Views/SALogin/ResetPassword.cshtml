@model ERHuntCV.Models.SuperAdminResetPassword

@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Reset Super Admin Password</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          rel="stylesheet" />

    <!-- Super Admin Login CSS -->
    <link rel="stylesheet"
          href="~/css/SALogin.css" />

</head>

<body>

    <div class="sa-login-page">

        <div class="bg-circle bg-circle-one"></div>
        <div class="bg-circle bg-circle-two"></div>

        <div class="sa-login-wrapper">

            <div class="sa-login-card">

                <!-- ==========================================
                     HEADER
                =========================================== -->

                <div class="sa-login-brand">

                    <div class="sa-login-icon">
                        <i class="fas fa-key"></i>
                    </div>

                    <h2>
                        Reset Password
                    </h2>

                    <p>
                        Reset your Super Admin account password
                    </p>

                </div>


                <!-- ==========================================
                     SECURITY BADGE
                =========================================== -->

                <div class="security-badge">

                    <i class="fas fa-shield-halved"></i>

                    Super Admin Password Reset

                </div>


                <!-- ==========================================
                     VALIDATION SUMMARY
                =========================================== -->

                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="ModelOnly"
                         class="login-error">
                    </div>
                }


                <!-- ==========================================
                     RESET PASSWORD FORM
                =========================================== -->

                <form asp-controller="SALogin"
                      asp-action="ResetPassword"
                      method="post">

                    @Html.AntiForgeryToken()


                    <!-- ==========================================
                         EMAIL
                    =========================================== -->

                    <div class="sa-form-group">

                        <label asp-for="sEmail"
                               class="sa-form-label">

                            Registered Email Address

                        </label>

                        <div class="sa-input-wrapper">

                            <i class="fas fa-envelope sa-input-icon"></i>

                            <input asp-for="sEmail"
                                   class="sa-input"
                                   placeholder="Enter your registered email"
                                   autocomplete="email" />

                        </div>

                        <span asp-validation-for="sEmail"
                              class="field-validation">
                        </span>

                    </div>


                    <!-- ==========================================
                         NEW PASSWORD
                    =========================================== -->

                    <div class="sa-form-group">

                        <label asp-for="NewPassword"
                               class="sa-form-label">

                            New Password

                        </label>

                        <div class="sa-input-wrapper">

                            <i class="fas fa-lock sa-input-icon"></i>

                            <input asp-for="NewPassword"
                                   id="newPassword"
                                   class="sa-input"
                                   type="password"
                                   placeholder="Enter new password"
                                   autocomplete="new-password" />

                            <button type="button"
                                    class="password-toggle"
                                    id="toggleNewPassword"
                                    aria-label="Show password">

                                <i class="fas fa-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="NewPassword"
                              class="field-validation">
                        </span>

                    </div>


                    <!-- ==========================================
                         CONFIRM PASSWORD
                    =========================================== -->

                    <div class="sa-form-group">

                        <label asp-for="ConfirmPassword"
                               class="sa-form-label">

                            Confirm Password

                        </label>

                        <div class="sa-input-wrapper">

                            <i class="fas fa-lock sa-input-icon"></i>

                            <input asp-for="ConfirmPassword"
                                   id="confirmPassword"
                                   class="sa-input"
                                   type="password"
                                   placeholder="Confirm new password"
                                   autocomplete="new-password" />

                            <button type="button"
                                    class="password-toggle"
                                    id="toggleConfirmPassword"
                                    aria-label="Show password">

                                <i class="fas fa-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="ConfirmPassword"
                              class="field-validation">
                        </span>

                    </div>


                    <!-- ==========================================
                         RESET BUTTON
                    =========================================== -->

                    <button type="submit"
                            class="sa-login-button">

                        <i class="fas fa-key"></i>

                        <span>
                            Reset Password
                        </span>

                    </button>


                    <!-- ==========================================
                         BACK TO LOGIN
                    =========================================== -->

                    <div class="text-center mt-3">

                        <a asp-controller="SALogin"
                           asp-action="Index"
                           class="text-primary text-decoration-none fw-semibold">

                            <i class="fas fa-arrow-left me-1"></i>

                            Back to Login

                        </a>

                    </div>

                </form>


                <!-- ==========================================
                     FOOTER
                =========================================== -->

                <div class="sa-login-footer">

                    <i class="fas fa-shield-halved"></i>

                    Authorized Super Admin Access Only

                </div>

            </div>

        </div>

    </div>


    <!-- ==========================================
         PASSWORD TOGGLE SCRIPT
    =========================================== -->

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            function setupPasswordToggle(inputId, buttonId) {

                const input =
                    document.getElementById(inputId);

                const button =
                    document.getElementById(buttonId);

                if (!input || !button) {
                    return;
                }

                button.addEventListener("click", function () {

                    const icon =
                        this.querySelector("i");

                    if (input.type === "password") {

                        input.type = "text";

                        icon.classList.remove("fa-eye");

                        icon.classList.add("fa-eye-slash");

                        this.setAttribute(
                            "aria-label",
                            "Hide password"
                        );

                    }
                    else {

                        input.type = "password";

                        icon.classList.remove("fa-eye-slash");

                        icon.classList.add("fa-eye");

                        this.setAttribute(
                            "aria-label",
                            "Show password"
                        );

                    }

                });

            }


            setupPasswordToggle(
                "newPassword",
                "toggleNewPassword"
            );


            setupPasswordToggle(
                "confirmPassword",
                "toggleConfirmPassword"
            );

        });

    </script>


    <partial name="_ValidationScriptsPartial" />

</body>

</html>