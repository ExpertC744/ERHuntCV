<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>HuntCV — Find the Right Job. Build the Right Career.</title>
	<link rel="stylesheet" href="~/css/huntcv-styles.css">
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
	<link rel="stylesheet"
		  href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
	<!-- SCROLL PROGRESS -->
	<div class="scroll-progress-track"><div class="scroll-progress-fill" id="scrollFill"></div></div>

	<!-- AMBIENT BACKGROUND -->
	<div class="ambient-blob" aria-hidden="true"></div>

	<!-- SECTION RAIL -->
	<nav class="section-rail" aria-label="Section navigation">
		<div class="section-rail-track"></div>
		<button class="rail-dot" data-section="explore"><span class="rail-label">Featured Jobs</span></button>
		<button class="rail-dot" data-section="companies"><span class="rail-label">Companies</span></button>
		<button class="rail-dot" data-section="resources"><span class="rail-label">Resources</span></button>
		<button class="rail-dot" data-section="about"><span class="rail-label">About</span></button>
	</nav>

	<!-- NAVBAR -->
	<!-- =========================================================
		 HUNTCV NAVBAR
		 BOOTSTRAP RESPONSIVE NAVBAR
		 ========================================================= -->
	<nav class="navbar navbar-expand-lg huntcv-navbar" id="siteNavbar">

		<div class="container-lg">

			<!-- LOGO -->
			<a class="navbar-brand huntcv-brand" href="#">

				<span class="brand-logo">

					<svg viewBox="0 0 40 40"
						 fill="none"
						 xmlns="http://www.w3.org/2000/svg">

						<path d="M8 20C8 13.37 13.37 8 20 8C26.63 8 32 13.37 32 20C32 26.63 26.63 32 20 32C13.37 32 8 26.63 8 20Z"
							  stroke="#2563EB"
							  stroke-width="2"
							  stroke-linecap="round"
							  stroke-linejoin="round" />

						<path d="M15 20L18 23L25 16"
							  stroke="#2563EB"
							  stroke-width="2.5"
							  stroke-linecap="round"
							  stroke-linejoin="round" />

					</svg>

				</span>

				<span class="brand-text">
					HuntCV
				</span>

			</a>


			<!-- MOBILE TOGGLE -->
			<button class="navbar-toggler huntcv-toggler"
					type="button"
					data-bs-toggle="collapse"
					data-bs-target="#huntcvNavbar"
					aria-controls="huntcvNavbar"
					aria-expanded="false"
					aria-label="Toggle navigation">

				<i class="bi bi-list"></i>

			</button>


			<!-- NAVIGATION -->
			<div class="collapse navbar-collapse" id="huntcvNavbar">

				<ul class="navbar-nav huntcv-nav-menu">

					<li class="nav-item">
						<a class="nav-link active"
						   href="#explore">
							Explore Jobs
						</a>
					</li>

					<li class="nav-item">
						<a class="nav-link"
						   href="#companies">
							Companies
						</a>
					</li>

					<li class="nav-item">
						<a class="nav-link"
						   href="#resources">
							Resources
						</a>
					</li>

					<li class="nav-item">
						<a class="nav-link"
						   href="#about">
							About
						</a>
					</li>

				</ul>



			</div>

		</div>

	</nav>


	<!-- HERO SECTION -->
	<section class="hero-section">

		<!-- ==========================================
			 DECORATIVE BACKGROUND
			 ========================================== -->

		<div class="hero-bg-circle circle-one"></div>
		<div class="hero-bg-circle circle-two"></div>
		<div class="hero-dots"></div>


		<!-- ==========================================
			 MAIN HERO CONTAINER
			 ========================================== -->

		<div class="container-lg hero-container">


			<!-- ======================================
				 LEFT SIDE : JOB SEARCH
				 ====================================== -->

			<div class="hero-left">

				<div class="hero-content">

					<!-- Eyebrow -->
					<span class="hero-eyebrow">

						<i class="bi bi-briefcase-fill"></i>

						Find your next opportunity

					</span>


					<!-- Main Heading -->
					<h1 class="hero-title">

						Find a job that

						<span>
							fits your career.
						</span>

					</h1>


					<!-- Description -->
					<p class="hero-subtitle">

						Discover thousands of opportunities from leading companies
						and take the next step in your professional journey.

					</p>

				</div>



				<!-- ==================================
					 JOB SEARCH BOX
					 ================================== -->

				<div class="search-container" id="heroSearch">


					<!-- Search Header -->

					<div class="search-heading">

						<div class="search-heading-icon">

							<i class="bi bi-search"></i>

						</div>


						<div>

							<h3>
								Search Jobs
							</h3>

							<span>
								Find opportunities that match your skills
							</span>

						</div>

					</div>



					<!-- ==================================
						 SEARCH INPUTS
						 ================================== -->

					<div class="search-input-group">


						<!-- JOB TITLE -->

						<div class="search-field">

							<div class="search-field-icon job-icon">

								<i class="bi bi-briefcase-fill"></i>

							</div>


							<div class="search-field-content">

								<label for="jobTitle">
									Job title or keyword
								</label>

								<input type="text"
									   id="jobTitle"
									   placeholder="e.g. Software Developer"
									   autocomplete="off">

							</div>

						</div>



						<!-- LOCATION -->

						<div class="search-field">

							<div class="search-field-icon location-icon">

								<i class="bi bi-geo-alt-fill"></i>

							</div>


							<div class="search-field-content">

								<label for="location">
									Location
								</label>

								<input type="text"
									   id="location"
									   placeholder="City or Remote"
									   autocomplete="off">

							</div>

						</div>



						<!-- SEARCH BUTTON -->

						<button type="button"
								class="btn-search">

							<i class="bi bi-search"></i>

							<span>
								Search Jobs
							</span>

						</button>

					</div>



					<!-- ==================================
						 SEARCH FILTERS
						 ================================== -->

					<div class="search-options">


						<!-- Remote -->

						<label class="checkbox-label">

							<input type="checkbox"
								   id="remoteOnly">

							<span class="custom-check"></span>

							<span>
								Remote only
							</span>

						</label>



						<!-- Recently Posted -->

						<label class="checkbox-label">

							<input type="checkbox"
								   id="recentJobs">

							<span class="custom-check"></span>

							<span>
								Recently posted
							</span>

						</label>



						<!-- Advanced Search -->

						<a href="#explore"
						   class="advanced-search">

							<span>
								Advanced Search
							</span>

							<i class="bi bi-arrow-right"></i>

						</a>

					</div>

				</div>



				<!-- ==================================
					 TRUST AREA
					 ================================== -->

				<div class="hero-trustline">


					<!-- Avatars -->

					<div class="trust-avatars">

						<span class="avatar avatar-one">
							<i class="bi bi-person-fill"></i>
						</span>

						<span class="avatar avatar-two">
							<i class="bi bi-person-fill"></i>
						</span>

						<span class="avatar avatar-three">
							<i class="bi bi-person-fill"></i>
						</span>

						<span class="avatar avatar-four">
							<i class="bi bi-person-fill"></i>
						</span>

					</div>



					<!-- Trust Content -->

					<div class="trust-content">


						<!-- Stars -->

						<div class="trust-stars">

							<i class="bi bi-star-fill"></i>
							<i class="bi bi-star-fill"></i>
							<i class="bi bi-star-fill"></i>
							<i class="bi bi-star-fill"></i>
							<i class="bi bi-star-fill"></i>

						</div>


						<!-- Text -->

						<span>

							Trusted by
							<strong>2.5M+</strong>
							job seekers

						</span>

					</div>

				</div>

			</div>



			<!-- ======================================
				 RIGHT SIDE : LOGIN
				 ====================================== -->

			<div class="hero-right">


				<!-- ==================================
					 LOGIN CARD
					 ================================== -->

				<div class="login-card">


					<!-- Decorative Card Glow -->

					<div class="login-card-glow"></div>



					<!-- ==================================
						 LOGIN HEADER
						 ================================== -->

					<div class="login-card-header">


						<!-- Logo -->

						<div class="login-logo">

							<div class="login-logo-icon">

								<i class="bi bi-person-check-fill"></i>

							</div>

						</div>



						<!-- Heading -->

						<h2>
							Welcome Back
						</h2>


						<!-- Description -->

						<p>
							Login to continue your job search
						</p>

					</div>



					<!-- ==================================
						 LOGIN FORM
						 ================================== -->

					<form class="login-form"
						  id="loginForm">


						<!-- ==================================
							 EMAIL
							 ================================== -->

						<div class="login-field">

							<label for="loginEmail">
								Email Address
							</label>


							<div class="login-input-wrapper">

								<div class="login-input-icon email-icon">

									<i class="bi bi-envelope-fill"></i>

								</div>


								<input type="email"
									   id="loginEmail"
									   name="email"
									   placeholder="Enter your email"
									   autocomplete="email"
									   required>

							</div>

						</div>



						<!-- ==================================
							 PASSWORD
							 ================================== -->

						<div class="login-field">


							<!-- Password Label -->

							<div class="password-label-row">

								<label for="loginPassword">
									Password
								</label>


								<a href="#forgot">
									Forgot password?
								</a>

							</div>



							<!-- Password Input -->

							<div class="login-input-wrapper">

								<div class="login-input-icon password-icon">

									<i class="bi bi-lock-fill"></i>

								</div>


								<input type="password"
									   id="loginPassword"
									   name="password"
									   placeholder="Enter your password"
									   autocomplete="current-password"
									   required>


								<!-- Eye -->

								<button type="button"
										class="password-toggle"
										id="passwordToggle"
										aria-label="Show password">

									<i class="bi bi-eye"></i>

								</button>

							</div>

						</div>



						<!-- ==================================
							 REMEMBER ME
							 ================================== -->

						<div class="remember-row">

							<label class="remember-me">

								<input type="checkbox"
									   id="rememberMe">

								<span class="remember-check"></span>

								<span>
									Remember me
								</span>

							</label>

						</div>



						<!-- ==================================
							 LOGIN BUTTON
							 ================================== -->

						<div class="login-button-wrapper">

							<button type="submit"
									class="login-submit">

								<span>
									Login
								</span>

								<i class="bi bi-arrow-right"></i>

							</button>

						</div>



						<!-- ==================================
							 DIVIDER
							 ================================== -->

						<div class="login-divider">

							<span>
								or continue with
							</span>

						</div>



						<!-- ==================================
							 SOCIAL LOGIN
							 ================================== -->

						<div class="social-login">


							<!-- EMAIL -->

							<button type="button"
									class="social-btn social-email"
									title="Continue with Email">

								<span class="social-icon email-social-icon">

									<i class="bi bi-envelope-fill"></i>

								</span>

								<span>
									Email
								</span>

							</button>



							<!-- GOOGLE -->

							<button type="button"
									class="social-btn social-google"
									title="Continue with Google">

								<span class="social-icon google-icon">

									<i class="bi bi-google"></i>

								</span>

								<span>
									Google
								</span>

							</button>



							<!-- LINKEDIN -->

							<button type="button"
									class="social-btn social-linkedin"
									title="Continue with LinkedIn">

								<span class="social-icon linkedin-icon">

									<i class="bi bi-linkedin"></i>

								</span>

								<span>
									LinkedIn
								</span>

							</button>

						</div>



						<!-- ==================================
							 CREATE ACCOUNT
							 ================================== -->

						<div class="register-text">

							<span>
								Don't have an account?
							</span>

							<a href="#signup">
								Create Account
							</a>

						</div>

					</form>

				</div>

			</div>

		</div>



		<!-- ==========================================
			 SCROLL CUE
			 ========================================== -->

		<div class="scroll-cue"
			 id="scrollCue">

			<span>
				Explore
			</span>

			<div class="scroll-cue-arrow"></div>

		</div>

	</section>
	<!-- TRUST & STATISTICS SECTION -->
	<section class="stats-section">
		<div class="container-lg">
			<div class="stats-grid">
				<div class="stat-card">
					<div class="stat-value"><span class="counter" data-target="2.5" data-suffix="M+">0</span></div>
					<div class="stat-label">Active Job Seekers</div>
				</div>
				<div class="stat-card">
					<div class="stat-value"><span class="counter" data-target="15" data-suffix="K+">0</span></div>
					<div class="stat-label">Top Companies</div>
				</div>
				<div class="stat-card">
					<div class="stat-value"><span class="counter" data-target="50" data-suffix="K+">0</span></div>
					<div class="stat-label">Jobs Posted Daily</div>
				</div>
				<div class="stat-card">
					<div class="stat-value"><span class="counter" data-target="92" data-suffix="%">0</span></div>
					<div class="stat-label">User Satisfaction</div>
				</div>
			</div>
		</div>
	</section>

	<!-- FEATURED JOBS SECTION -->
	<section class="featured-jobs-section" id="explore">
		<div class="container-lg">
			<div class="section-header reveal">
				<div>
					<span class="eyebrow">Fresh matches</span>
					<h2>Featured Job Opportunities</h2>
					<p>Handpicked roles from companies actively hiring top talent across India</p>
				</div>
				<a href="#" class="view-all">View all jobs &rarr;</a>
			</div>

			<div class="jobs-grid">
				<div class="job-card reveal reveal-delay-1">
					<div class="job-header">
						<div class="company-logo">
							<svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
								<circle cx="24" cy="24" r="22" fill="#3B82F6" />
								<text x="24" y="32" text-anchor="middle" font-size="20" fill="white" font-weight="600">TC</text>
							</svg>
						</div>
						<div class="job-meta">
							<div class="job-title">Senior Full Stack Engineer</div>
							<div class="job-company">TechCorp &middot; Bengaluru</div>
						</div>
						<button class="btn-save" title="Save job" onclick="this.classList.toggle('is-saved')">
							<i class="bi bi-bookmark"></i>
						</button>
					</div>
					<div class="job-match-row">
						<div class="match-ring gold"><span>96%</span></div>
						<span class="job-match-label">Match score <strong>96/100</strong></span>
					</div>
					<div class="job-details">
						<span class="badge-tag">Full-time</span>
						<span class="badge-tag">Remote</span>
					</div>
					<div class="job-description">
						Build scalable systems for millions of users. Work with React, Node.js, and cloud infrastructure.
					</div>
					<div class="job-footer">
						<div class="job-salary">&#8377;18L&ndash;&#8377;28L /yr</div>
						<button class="btn-apply">Apply Now</button>
					</div>
				</div>

				<div class="job-card reveal reveal-delay-2">
					<div class="job-header">
						<div class="company-logo">
							<svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
								<circle cx="24" cy="24" r="22" fill="#10B981" />
								<text x="24" y="32" text-anchor="middle" font-size="20" fill="white" font-weight="600">IL</text>
							</svg>
						</div>
						<div class="job-meta">
							<div class="job-title">Product Manager - AI/ML</div>
							<div class="job-company">InnovateLabs &middot; Hyderabad</div>
						</div>
						<button class="btn-save" title="Save job" onclick="this.classList.toggle('is-saved')">
							<i class="bi bi-bookmark"></i>
						</button>
					</div>
					<div class="job-match-row">
						<div class="match-ring"><span>90%</span></div>
						<span class="job-match-label">Match score <strong>90/100</strong></span>
					</div>
					<div class="job-details">
						<span class="badge-tag">Full-time</span>
						<span class="badge-tag">Hyderabad, TG</span>
					</div>
					<div class="job-description">
						Lead product strategy for our AI platform. Define roadmap, work with engineering and design teams.
					</div>
					<div class="job-footer">
						<div class="job-salary">&#8377;22L&ndash;&#8377;32L /yr</div>
						<button class="btn-apply">Apply Now</button>
					</div>
				</div>

				<div class="job-card reveal reveal-delay-3">
					<div class="job-header">
						<div class="company-logo">
							<svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
								<circle cx="24" cy="24" r="22" fill="#8B5CF6" />
								<text x="24" y="32" text-anchor="middle" font-size="20" fill="white" font-weight="600">DH</text>
							</svg>
						</div>
						<div class="job-meta">
							<div class="job-title">Lead UX/UI Designer</div>
							<div class="job-company">DesignHub &middot; Mumbai</div>
						</div>
						<button class="btn-save" title="Save job" onclick="this.classList.toggle('is-saved')">
							<i class="bi bi-bookmark"></i>
						</button>
					</div>
					<div class="job-match-row">
						<div class="match-ring"><span>87%</span></div>
						<span class="job-match-label">Match score <strong>87/100</strong></span>
					</div>
					<div class="job-details">
						<span class="badge-tag">Full-time</span>
						<span class="badge-tag">Mumbai, MH</span>
					</div>
					<div class="job-description">
						Design intuitive interfaces for millions. Lead design system, mentor junior designers, shape product vision.
					</div>
					<div class="job-footer">
						<div class="job-salary">&#8377;14L&ndash;&#8377;20L /yr</div>
						<button class="btn-apply">Apply Now</button>
					</div>
				</div>

				<div class="job-card reveal reveal-delay-4">
					<div class="job-header">
						<div class="company-logo">
							<svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
								<circle cx="24" cy="24" r="22" fill="#F59E0B" />
								<text x="24" y="32" text-anchor="middle" font-size="20" fill="white" font-weight="600">SF</text>
							</svg>
						</div>
						<div class="job-meta">
							<div class="job-title">DevOps Engineer</div>
							<div class="job-company">StartupFoundry &middot; Remote</div>
						</div>
						<button class="btn-save" title="Save job" onclick="this.classList.toggle('is-saved')">
							<i class="bi bi-bookmark"></i>
						</button>
					</div>
					<div class="job-match-row">
						<div class="match-ring"><span>82%</span></div>
						<span class="job-match-label">Match score <strong>82/100</strong></span>
					</div>
					<div class="job-details">
						<span class="badge-tag">Full-time</span>
						<span class="badge-tag">Remote</span>
					</div>
					<div class="job-description">
						Manage cloud infrastructure at scale. Work with Kubernetes, AWS, and CI/CD pipelines for growing team.
					</div>
					<div class="job-footer">
						<div class="job-salary">&#8377;12L&ndash;&#8377;20L /yr</div>
						<button class="btn-apply">Apply Now</button>
					</div>
				</div>

				<div class="job-card reveal reveal-delay-5">
					<div class="job-header">
						<div class="company-logo">
							<svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
								<circle cx="24" cy="24" r="22" fill="#EC4899" />
								<text x="24" y="32" text-anchor="middle" font-size="20" fill="white" font-weight="600">VL</text>
							</svg>
						</div>
						<div class="job-meta">
							<div class="job-title">Data Scientist</div>
							<div class="job-company">VentureLabs &middot; Pune</div>
						</div>
						<button class="btn-save" title="Save job" onclick="this.classList.toggle('is-saved')">
							<i class="bi bi-bookmark"></i>
						</button>
					</div>
					<div class="job-match-row">
						<div class="match-ring"><span>85%</span></div>
						<span class="job-match-label">Match score <strong>85/100</strong></span>
					</div>
					<div class="job-details">
						<span class="badge-tag">Full-time</span>
						<span class="badge-tag">Pune, MH</span>
					</div>
					<div class="job-description">
						Build ML models for financial forecasting. Work with large datasets and cutting-edge analytics tools.
					</div>
					<div class="job-footer">
						<div class="job-salary">&#8377;16L&ndash;&#8377;26L /yr</div>
						<button class="btn-apply">Apply Now</button>
					</div>
				</div>

				<div class="job-card reveal reveal-delay-6">
					<div class="job-header">
						<div class="company-logo">
							<svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
								<circle cx="24" cy="24" r="22" fill="#14B8A6" />
								<text x="24" y="32" text-anchor="middle" font-size="20" fill="white" font-weight="600">CF</text>
							</svg>
						</div>
						<div class="job-meta">
							<div class="job-title">QA Automation Engineer</div>
							<div class="job-company">CloudFirst &middot; Remote</div>
						</div>
						<button class="btn-save" title="Save job" onclick="this.classList.toggle('is-saved')">
							<i class="bi bi-bookmark"></i>
						</button>
					</div>
					<div class="job-match-row">
						<div class="match-ring"><span>79%</span></div>
						<span class="job-match-label">Match score <strong>79/100</strong></span>
					</div>
					<div class="job-details">
