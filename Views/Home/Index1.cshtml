@{
    ViewData["Title"] = "Find the Right Job. Build the Right Career.";
}

<!-- NAVBAR -->
<nav class="huntcv-navbar">
    <div class="container-lg">
        <div class="navbar-brand">
            <div class="brand-logo">
                <svg viewBox="0 0 40 40" width="32" height="32" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M8 20C8 13.37 13.37 8 20 8C26.63 8 32 13.37 32 20C32 26.63 26.63 32 20 32C13.37 32 8 26.63 8 20Z" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M15 20L18 23L25 16" stroke="#2563EB" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </div>
            <span class="brand-text">HuntCV</span>
        </div>
        
        <div class="navbar-menu">
            <a href="#explore" class="nav-link">Explore Jobs</a>
            <a href="#companies" class="nav-link">Companies</a>
            <a href="#resources" class="nav-link">Resources</a>
            <a href="#about" class="nav-link">About</a>
        </div>
        
        <div class="navbar-actions">
            <button class="btn-text">Sign In</button>
            <button class="btn-primary">Post a Job</button>
        </div>
    </div>
</nav>

<!-- HERO SECTION -->
<section class="hero-section">
    <div class="container-lg">
        <div class="hero-content">
            <div class="hero-text">
                <h1 class="hero-title">Find the Right Job.<br>Build the Right Career.</h1>
                <p class="hero-subtitle">HuntCV connects talented professionals with the right opportunities, trusted companies, and career resources.</p>
                
                <!-- Advanced Search Box -->
                <div class="search-container">
                    <div class="search-input-group">
                        <div class="search-field">
                            <i class="bi bi-briefcase"></i>
                            <input type="text" placeholder="Job title, keywords..." id="jobTitle">
                        </div>
                        <div class="search-field">
                            <i class="bi bi-geo-alt"></i>
                            <input type="text" placeholder="City or remote" id="location">
                        </div>
                        <button class="btn-search">
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>
                    <div class="search-options">
                        <label class="checkbox-label">
                            <input type="checkbox"> Remote only
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox"> Recently posted
                        </label>
                    </div>
                </div>
            </div>
            
            <div class="hero-visual">
                <div class="hero-cards">
                    <div class="hero-card card-1">
                        <div class="card-badge">Senior Developer</div>
                        <div class="card-company">TechCorp</div>
                        <div class="card-location">
                            <i class="bi bi-geo-alt"></i> San Francisco, CA
                        </div>
                        <div class="card-salary">$180K - $220K</div>
                    </div>
                    <div class="hero-card card-2">
                        <div class="card-badge">Product Manager</div>
                        <div class="card-company">InnovateLabs</div>
                        <div class="card-location">
                            <i class="bi bi-geo-alt"></i> Remote
                        </div>
                        <div class="card-salary">$140K - $180K</div>
                    </div>
                    <div class="hero-card card-3">
                        <div class="card-badge">UX Designer</div>
                        <div class="card-company">DesignHub</div>
                        <div class="card-location">
                            <i class="bi bi-geo-alt"></i> New York, NY
                        </div>
                        <div class="card-salary">$110K - $150K</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

