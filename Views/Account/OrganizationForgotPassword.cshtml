@model ERHuntCV.Models.OrganizationForgotPassword

@{
    ViewData["Title"] = "Organization Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Organization Forgot Password - Er Job Portal
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/css/CandidateLogin.css" />

    <style>

        body {
            font-family: 'Inter', sans-serif;
            background: #f5f7fb;
        }

        .forgot-card {
            border: 0;
            border-radius: 18px;
        }

        .icon-wrapper {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            background: #e8f0ff;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
        }

        .icon-wrapper i {
            font-size: 30px;
            color: #0d6efd;
        }

        .form-control {
            min-height: 46px;
        }

        .btn-primary {
            min-height: 46px;
            font-weight: 600;
        }

    </style>

</head>

<body>

    <div class="container">

        <div class="row justify-content-center align-items-center min-vh-100">

            <div class="col-md-6 col-lg-5">

                <div class="card shadow forgot-card">

                    <div class="card-body p-4 p-md-5">

                        <!-- HEADER -->

                        <div class="text-center mb-4">

                            <div class="icon-wrapper">

                                <i class="fas fa-building"></i>

                            </div>

                            <h3 class="fw-bold">
                                Forgot Password?
                            </h3>

                            <p class="text-muted mb-0">
                                Enter your registered organization
                                email address and we will send
                                your login details.
                            </p>

                        </div>


                        <!-- SUCCESS -->

                        @if (TempData["Success"] != null)
                        {
                            <div class="alert alert-success">

                                <i class="fas fa-check-circle me-2"></i>

                                @TempData["Success"]

                            </div>
                        }


                        <!-- ERROR -->

                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger">

                                <i class="fas fa-exclamation-circle me-2"></i>

                                @ViewBag.Error

                            </div>
                        }


                        <!-- VALIDATION -->

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <!-- FORM -->

                        <form asp-controller="Account"
                              asp-action="OrganizationForgotPassword"
                              method="post">

                            @Html.AntiForgeryToken()


                            <!-- EMAIL -->

                            <div class="mb-3">

                                <label asp-for="sEmail"
                                       class="form-label fw-semibold">

                                    Registered Organization Email

                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">

                                        <i class="fas fa-envelope"></i>

                                    </span>

                                    <input asp-for="sEmail"
                                           class="form-control"
                                           placeholder="Enter registered email address"
                                           autocomplete="email" />

                                </div>

                                <span asp-validation-for="sEmail"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- SUBMIT -->

                            <button type="submit"
                                    class="btn btn-primary w-100 py-2">

                                <i class="fas fa-paper-plane me-2"></i>

                                Send Login Details

                            </button>

                        </form>


                        <!-- BACK -->

                        <div class="text-center mt-4">

                            <a asp-controller="Account"
                               asp-action="OrganizationLogin"
                               class="text-decoration-none">

                                <i class="fas fa-arrow-left me-1"></i>

                                Back to Organization Login

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <partial name="_ValidationScriptsPartial" />

</body>

</html>