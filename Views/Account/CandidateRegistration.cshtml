@model HuntCV_Portal.Models.CandidateRegisterM

@{
    Layout = null;
    ViewData["Title"] = "Candidate Registration";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Candidate Registration - HuntCV</title>

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet"
          href="~/css/CandidateRegister.css" />

</head>

<body>

    <div class="register-page">

        <div class="register-glow glow-one"></div>
        <div class="register-glow glow-two"></div>

        <div class="container">

            <!-- BRAND -->

            <div class="register-brand">

                <div class="brand-logo">
                    <i class="bi bi-briefcase-fill"></i>
                </div>

                <span>
                    Hunt<span>CV</span>
                </span>

            </div>


            <!-- REGISTER CARD -->

            <div class="register-card">

                <!-- HEADER -->

                <div class="register-header">

                    <div class="register-title-icon">

                        <i class="bi bi-person-plus-fill"></i>

                    </div>

                    <div>

                        <h1>Create Your Account</h1>

                        <p>
                            Join HuntCV and take the next step
                            in your career.
                        </p>

                    </div>

                </div>


                <!-- PROGRESS -->

                <div class="registration-progress">

                    <div class="progress-step active">

                        <span>1</span>

                        <div>
                            <strong>Personal Details</strong>
                            <small>Your basic information</small>
                        </div>

                    </div>

                    <div class="progress-line"></div>

                    <div class="progress-step">

                        <span>2</span>

                        <div>
                            <strong>Account Security</strong>
                            <small>Create your password</small>
                        </div>

                    </div>

                </div>


                <!-- FORM -->

                <form asp-controller="Account"
                      asp-action="CandidateRegistration"
                      method="post"
                      enctype="multipart/form-data"
                      id="registerForm">

                    @Html.AntiForgeryToken()


                    <!-- VALIDATION -->

                    <div asp-validation-summary="ModelOnly"
                         class="validation-summary">
                    </div>


                    <div class="row g-4">


                        <!-- LEFT COLUMN -->

                        <div class="col-lg-8">

                            <div class="section-title">

                                <div class="section-icon">

                                    <i class="bi bi-person"></i>

                                </div>

                                <div>

                                    <h3>Personal Information</h3>

                                    <p>
                                        Tell us a little about yourself.
                                    </p>

                                </div>

                            </div>


                            <div class="row g-3">


                                <!-- FIRST NAME -->

                                <div class="col-md-6">

                                    <div class="field-group">

                                        <label asp-for="sFName">
                                            First Name
                                            <span>*</span>
                                        </label>

                                        <div class="input-box">

                                            <i class="bi bi-person"></i>

                                            <input asp-for="sFName"
                                                   class="form-control"
                                                   placeholder="Enter first name" />

                                        </div>

                                        <span asp-validation-for="sFName"
                                              class="field-error">
                                        </span>

                                    </div>

                                </div>


                                <!-- LAST NAME -->

                                <div class="col-md-6">

                                    <div class="field-group">

                                        <label asp-for="sLName">
                                            Last Name
                                        </label>

                                        <div class="input-box">

                                            <i class="bi bi-person"></i>

                                            <input asp-for="sLName"
                                                   class="form-control"
                                                   placeholder="Enter last name" />

                                        </div>

                                        <span asp-validation-for="sLName"
                                              class="field-error">
                                        </span>

                                    </div>

                                </div>


                                <!-- GENDER -->

                                <div class="col-md-6">

                                    <div class="field-group">

                                        <label>
                                            Gender
                                            <span>*</span>
                                        </label>

                                        <div class="gender-options">


                                            <label class="gender-card">

                                                <input type="radio"
                                                       asp-for="nGender"
                                                       value="1" />

                                                <span class="gender-content">

                                                    <i class="bi bi-gender-male"></i>

                                                    <span>Male</span>

                                                </span>

                                            </label>


                                            <label class="gender-card">

                                                <input type="radio"
                                                       asp-for="nGender"
                                                       value="2" />

                                                <span class="gender-content">

                                                    <i class="bi bi-gender-female"></i>

                                                    <span>Female</span>

                                                </span>

                                            </label>


                                            <label class="gender-card">

                                                <input type="radio"
                                                       asp-for="nGender"
                                                       value="3" />

                                                <span class="gender-content">

                                                    <i class="bi bi-gender-ambiguous"></i>

                                                    <span>Other</span>

                                                </span>

                                            </label>

                                        </div>

                                        <span asp-validation-for="nGender"
                                              class="field-error">
                                        </span>

                                    </div>

                                </div>


                                <!-- DOB -->

                                <div class="col-md-6">

                                    <div class="field-group">

                                        <label asp-for="DOB">

                                            Date of Birth

                                            <span>*</span>

                                        </label>

                                        <div class="input-box">

                                            <i class="bi bi-calendar3"></i>

                                            <input asp-for="DOB"
                                                   type="date"
                                                   class="form-control" />

                                        </div>

                                        <span asp-validation-for="DOB"
                                              class="field-error">
                                        </span>

                                    </div>

                                </div>


                                <!-- MOBILE -->

                                <div class="col-md-6">

                                    <div class="field-group">

                                        <label asp-for="sMobile">

                                            Mobile Number

                                            <span>*</span>

                                        </label>

                                        <div class="input-box">

                                            <i class="bi bi-phone"></i>

                                            <input asp-for="sMobile"
                                                   class="form-control"
                                                   maxlength="20"
                                                   inputmode="numeric"
                                                   placeholder="Enter mobile number" />

                                        </div>

                                        <span asp-validation-for="sMobile"
                                              class="field-error">
                                        </span>

                                    </div>

                                </div>


                                <!-- EMAIL -->

                                <div class="col-md-6">

                                    <div class="field-group">

                                        <label asp-for="sEmail">

                                            Email Address

                                            <span>*</span>

                                        </label>

                                        <div class="input-box">

                                            <i class="bi bi-envelope"></i>

                                            <input asp-for="sEmail"
                                                   type="email"
                                                   class="form-control"
                                                   placeholder="Enter email address" />

                                        </div>

                                        <span asp-validation-for="sEmail"
                                              class="field-error">
                                        </span>

                                    </div>

                                </div>


                                <!-- OTP -->

                                <div class="col-12">

                                    <div class="otp-container">

                                        <div class="otp-header">

                                            <div>

                                                <label asp-for="sOTP">

                                                    Email Verification OTP

                                                </label>

                                                <p>

                                                    Verify your email address
                                                    using the OTP.

                                                </p>

                                            </div>


                                            <button type="button"
                                                    class="send-otp-btn"
                                                    id="sendOtpBtn">

                                                <i class="bi bi-send"></i>

                                                Send OTP

                                            </button>

                                        </div>


                                        <div class="otp-input-wrapper">

                                            <i class="bi bi-shield-lock"></i>

                                            <input asp-for="sOTP"
                                                   class="form-control"
                                                   maxlength="6"
                                                   inputmode="numeric"
                                                   placeholder="Enter 6-digit OTP" />

                                        </div>

                                        <span asp-validation-for="sOTP"
                                              class="field-error">
                                        </span>

                                    </div>

                                </div>


                                <!-- CAPTCHA -->

                                <div class="col-12">

                                    <div class="field-group">

                                        <label asp-for="sCaptcha">

                                            CAPTCHA

                                            <span>*</span>

                                        </label>


                                        <div class="captcha-row">


                                            <div class="captcha-display"
                                                 id="captchaDisplay">

                                                A7K9P

                                            </div>


                                            <button type="button"
                                                    class="captcha-refresh"
                                                    id="refreshCaptcha">

                                                <i class="bi bi-arrow-clockwise"></i>

                                            </button>


                                            <div class="input-box captcha-input">

                                                <i class="bi bi-shield-check"></i>

                                                <input asp-for="sCaptcha"
                                                       class="form-control"
                                                       maxlength="20"
                                                       autocomplete="off"
                                                       placeholder="Enter CAPTCHA" />

                                            </div>

                                        </div>


                                        <span asp-validation-for="sCaptcha"
                                              class="field-error">
                                        </span>

                                    </div>

                                </div>


                            </div>

                        </div>


                        <!-- RIGHT COLUMN -->

                        <div class="col-lg-4">


                            <!-- PROFILE PHOTO -->

                            <div class="profile-section">

                                <div class="section-title small-title">

                                    <div class="section-icon">

                                        <i class="bi bi-camera"></i>

                                    </div>

                                    <div>

                                        <h3>Profile Photo</h3>

                                        <p>
                                            Add a professional photo.
                                        </p>

                                    </div>

                                </div>


                                <div class="profile-upload">


                                    <div class="profile-preview"
                                         id="profilePreview">

                                        <i class="bi bi-person"></i>

                                    </div>


                                    <label for="ProfileImage"
                                           class="upload-btn">

                                        <i class="bi bi-cloud-arrow-up"></i>

                                        Choose Photo

                                    </label>


                                    <input asp-for="ProfileImageFile"
                                           type="file"
                                           id="ProfileImage"
                                           accept="image/png,image/jpeg,image/jpg"
                                           hidden />


                                    <small>
                                        JPG or PNG · Max 2 MB
                                    </small>

                                </div>

                            </div>


                            <!-- ACCOUNT SECURITY -->

                            <div class="security-section">

                                <div class="section-title small-title">

                                    <div class="section-icon">

                                        <i class="bi bi-lock"></i>

                                    </div>

                                    <div>

                                        <h3>Account Security</h3>

                                        <p>
                                            Keep your account secure.
                                        </p>

                                    </div>

                                </div>


                                <!-- PASSWORD -->

                                <div class="field-group">

                                    <label asp-for="sPassword">

                                        Password

                                        <span>*</span>

                                    </label>


                                    <div class="input-box">

                                        <i class="bi bi-lock"></i>

                                        <input asp-for="sPassword"
                                               type="password"
                                               class="form-control password-field"
                                               placeholder="Create password" />


                                        <button type="button"
                                                class="password-toggle">

                                            <i class="bi bi-eye"></i>

                                        </button>

                                    </div>


                                    <div class="password-strength">

                                        <div class="strength-bars">

                                            <span></span>
                                            <span></span>
                                            <span></span>
                                            <span></span>

                                        </div>

                                        <small id="strengthText">

                                            Password strength

                                        </small>

                                    </div>


                                    <span asp-validation-for="sPassword"
                                          class="field-error">
                                    </span>

                                </div>


                                <!-- CONFIRM PASSWORD -->
                                @*  <div class="field-group">

                                    <label>

                                        Confirm Password

                                        <span>*</span>

                                    </label>


                                    <div class="input-box">

                                        <i class="bi bi-lock-fill"></i>

                                        <input type="password"
                                               id="ConfirmPassword"
                                               class="form-control password-field"
                                               placeholder="Confirm password"
                                               autocomplete="new-password" />


                                        <button type="button"
                                                class="password-toggle">

                                            <i class="bi bi-eye"></i>

                                        </button>

                                    </div>


                                    <span id="confirmPasswordError"
                                          class="field-error">
                                    </span>

                                </div> *@


                            </div>

                        </div>

                    </div>


                    <!-- TERMS -->

                    <div class="terms-box">

                        <label>

                            <input type="checkbox"
                                   id="terms"
                                   required />

                            <span class="custom-check"></span>

                            <span>

                                I agree to the
                                <a href="#">Terms & Conditions</a>
                                and
                                <a href="#">Privacy Policy</a>
                                of HuntCV.

                            </span>

                        </label>

                    </div>


                    <!-- SUBMIT -->

                    <div class="register-submit">

                        <button type="submit"
                                class="create-account-btn">

                            <span>
                                Create Candidate Account
                            </span>

                            <i class="bi bi-arrow-right"></i>

                        </button>

                    </div>


                    <!-- LOGIN -->

                    <div class="already-account">

                        Already have an account?

                        <a asp-controller="Account"
                           asp-action="CandidateLogin">

                            Sign In

                        </a>

                    </div>


                </form>

            </div>


            <!-- FOOTER -->

            <div class="register-footer">

                <span>
                    © @DateTime.Now.Year HuntCV
                </span>

                <span>•</span>

                <a href="#">Privacy</a>

                <span>•</span>

                <a href="#">Terms</a>

            </div>

        </div>

    </div>


    <!-- SCRIPTS -->

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>


    <script>

        /* ==============================
        PROFILE IMAGE
        ============================== */

        document
        .getElementById("ProfileImage")
        .addEventListener("change", function (event) {

        const file = event.target.files[0];

        if (!file)
        return;

        if (file.size > 2 * 1024 * 1024) {

        alert("Profile image must be less than 2 MB.");

        this.value = "";

        return;
        }

        const reader = new FileReader();

        reader.onload = function (e) {

        document.getElementById("profilePreview").innerHTML =
        `<img src="${e.target.result}"
        alt="Profile Preview">`;

        };

        reader.readAsDataURL(file);

        });


        /* ==============================
        PASSWORD SHOW / HIDE
        ============================== */

        document
        .querySelectorAll(".password-toggle")
        .forEach(function (button) {

        button.addEventListener("click", function () {

        const input =
        this.parentElement
        .querySelector(".password-field");

        const icon =
        this.querySelector("i");

        if (input.type === "password") {

        input.type = "text";

        icon.classList.remove("bi-eye");

        icon.classList.add("bi-eye-slash");

        }
        else {

        input.type = "password";

        icon.classList.remove("bi-eye-slash");

        icon.classList.add("bi-eye");

        }

        });

        });


        /* ==============================
        PASSWORD STRENGTH
        ============================== */

        const password =
        document.getElementById("sPassword");

        if (password) {

        password.addEventListener("input", function () {

        const value = this.value;

        const bars =
        document.querySelectorAll(
        ".strength-bars span");

        const text =
        document.getElementById(
        "strengthText");

        let strength = 0;

        if (value.length >= 8)
        strength++;

        if (/[A-Z]/.test(value))
        strength++;

        if (/[0-9]/.test(value))
        strength++;

        if (/[^A-Za-z0-9]/.test(value))
        strength++;


        bars.forEach(function (bar, index) {

        bar.classList.remove(
        "weak",
        "medium",
        "strong"
        );

        if (index < strength) {

        if (strength <= 1)
        bar.classList.add("weak");

        else if (strength <= 3)
        bar.classList.add("medium");

        else
        bar.classList.add("strong");

        }

        });


        if (strength === 0)
        text.textContent =
        "Password strength";

        else if (strength === 1)
        text.textContent =
        "Weak password";

        else if (strength <= 3)
        text.textContent =
        "Good password";

        else
        text.textContent =
        "Strong password";

        });

        }


        /* ==============================
        CONFIRM PASSWORD
        ============================== */

        document
        .getElementById("registerForm")
        .addEventListener("submit", function (event) {

        const password =
        document.getElementById("sPassword").value;

        const confirmPassword =
        document.getElementById(
        "ConfirmPassword").value;

        const error =
        document.getElementById(
        "confirmPasswordError");

        if (password !== confirmPassword) {

        event.preventDefault();

        error.textContent =
        "Passwords do not match.";

        return false;

        }

        error.textContent = "";

        });


        /* ==============================
        CAPTCHA
        ============================== */

        function generateCaptcha() {

        const characters =
        "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";

        let captcha = "";

        for (let i = 0; i < 5; i++) {

        captcha +=
        characters.charAt(
        Math.floor(
        Math.random() *
        characters.length
        )
        );

        }

        document.getElementById(
        "captchaDisplay"
        ).textContent = captcha;

        document.getElementById(
        "sCaptcha"
        ).value = "";

        }


        document
        .getElementById("refreshCaptcha")
        .addEventListener("click", function () {

        generateCaptcha();

        });


        /* ==============================
        MOBILE ONLY NUMBERS
        ============================== */

        document
        .getElementById("sMobile")
        .addEventListener("input", function () {

        this.value =
        this.value.replace(
        /[^0-9]/g,
        ""
        );

        });


        /* ==============================
        OTP BUTTON
        ============================== */

        document
        .getElementById("sendOtpBtn")
        .addEventListener("click", function () {

        const email =
        document.getElementById("sEmail").value;

        if (!email) {

        alert(
        "Please enter your email address first."
        );

        return;

        }

        const button = this;

        button.disabled = true;

        let seconds = 30;

        button.innerHTML =
        `<i class="bi bi-clock"></i>
        Resend in ${seconds}s`;


        const timer =
        setInterval(function () {

        seconds--;

        button.innerHTML =
        `<i class="bi bi-clock"></i>
        Resend in ${seconds}s`;


        if (seconds <= 0) {

        clearInterval(timer);

        button.disabled = false;

        button.innerHTML =
        `<i class="bi bi-send"></i>
        Send OTP`;

        }

        }, 1000);

        });

    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

        document.querySelectorAll("#registerForm input").forEach(function (input) {

        // Prevent space before entering the first character
        input.addEventListener("keydown", function (e) {

        if (e.key === " " && this.value.length === 0) {
        e.preventDefault();
        }

        });

        // Remove leading spaces when typing or pasting
        input.addEventListener("input", function () {

        this.value = this.value.replace(/^\s+/, "");

        });

        });

        });
    </script>

</body>
</html>
