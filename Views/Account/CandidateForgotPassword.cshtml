@model ERHuntCV.Models.CandidateForgotPassword
@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Forgot Password - Er Job Portal</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/css/CandidateLogin.css" />
</head>

<body>

    <div class="container">

        <div class="row justify-content-center align-items-center min-vh-100">

            <div class="col-md-6 col-lg-5">

                <div class="card shadow border-0 rounded-4">

                    <div class="card-body p-4 p-md-5">

                        <div class="text-center mb-4">

                            <div class="mb-3">
                                <i class="fas fa-key fa-3x text-primary"></i>
                            </div>

                            <h3 class="fw-bold">
                                Forgot Password?
                            </h3>

                            <p class="text-muted mb-0">
                                Enter your registered email address
                                and we will send your login details.
                            </p>

                        </div>

                        @if (TempData["Success"] != null)
                        {
                            <div class="alert alert-success">
                                @TempData["Success"]
                            </div>
                        }

                        @if (TempData["Error"] != null)
                        {
                            <div class="alert alert-danger">
                                @TempData["Error"]
                            </div>
                        }

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <form asp-controller="Account"
                              asp-action="CandidateForgotPassword"
                              method="post">

                            @Html.AntiForgeryToken()

                            <div class="mb-3">

                                <label asp-for="sEmail"
                                       class="form-label fw-semibold">
                                    Registered Email Address
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        <i class="fas fa-envelope"></i>
                                    </span>

                                    <input asp-for="sEmail"
                                           class="form-control"
                                           placeholder="Enter your registered email"
                                           autocomplete="email" />

                                </div>

                                <span asp-validation-for="sEmail"
                                      class="text-danger">
                                </span>

                            </div>

                            <button type="submit"
                                    class="btn btn-primary w-100 py-2">

                                <i class="fas fa-paper-plane me-2"></i>

                                Send Login Details

                            </button>

                        </form>

                        <div class="text-center mt-4">

                            <a asp-controller="Account"
                               asp-action="CandidateLogin"
                               class="text-decoration-none">

                                <i class="fas fa-arrow-left me-1"></i>

                                Back to Candidate Login

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <partial name="_ValidationScriptsPartial" />

</body>
</html>
