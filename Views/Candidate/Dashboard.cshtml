<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script src="~/js/huntcv-table.js"></script>
<script>

    /* ---------- last 10 months as "Jan 26" labels ---------- */
    function lastMonthLabels(count) {
        const names = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
                       "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
        const now = new Date();
        const labels = [];
        for (let i = count - 1; i >= 0; i--) {
            const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
            labels.push(names[d.getMonth()] + " " + String(d.getFullYear()).slice(-2));
        }
        return labels;
    }

    const labels = lastMonthLabels(10);

    /* ---------- STATIC DATA (replace with server data later) ----------
       e.g.  const suitableOpenings = @Html.Raw(Json.Serialize(ViewBag.SuitableOpenings)); */
    const suitableOpenings = [0, 0, 0, 0, 1, 0, 0, 1, 2, 0];
    const internshipPosts  = [0, 1, 16, 15, 70, 1, 21, 2, 3, 2];

    /* ---------- HuntCV palette ---------- */
    const BLUE   = "#2f5bea";
    const INDIGO = "#5b3df0";
    const GRID   = "#e6ebf8";
    const MUTED  = "#66719a";
    const INK    = "#0b1437";

    Chart.defaults.font.family = '"Inter", system-ui, -apple-system, "Segoe UI", sans-serif';
    Chart.defaults.color = MUTED;

    function baseOptions(yTitle) {
        return {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: "top",
                    labels: { color: INK, boxWidth: 40, boxHeight: 12, padding: 14 }
                },
                tooltip: {
                    backgroundColor: INK,
                    padding: 10,
                    cornerRadius: 10,
                    titleFont: { weight: "700" }
                }
            },
            scales: {
                x: {
                    grid: { color: GRID },
                    title: { display: true, text: "Months", color: MUTED }
                },
                y: {
                    beginAtZero: true,
                    grid: { color: GRID },
                    ticks: { precision: 0 },
                    title: { display: true, text: yTitle, color: MUTED }
                }
            }
        };
    }

    /* ---------- Area / line chart ---------- */
    new Chart(document.getElementById("suitableOpeningsChart"), {
        type: "line",
        data: {
            labels: labels,
            datasets: [{
                label: "No. of openings",
                data: suitableOpenings,
                fill: true,
                tension: 0,
                borderWidth: 2,
                borderColor: BLUE,
                backgroundColor: "rgba(47, 91, 234, .22)",
                pointRadius: 3.5,
                pointHoverRadius: 6,
                pointBackgroundColor: "#fff",
                pointBorderColor: INDIGO,
                pointBorderWidth: 2
            }]
        },
        options: baseOptions("No. of openings")
    });

    /* ---------- Bar chart ---------- */
    new Chart(document.getElementById("internshipPostsChart"), {
        type: "bar",
        data: {
            labels: labels,
            datasets: [{
                label: "No. of post",
                data: internshipPosts,
                backgroundColor: BLUE,
                hoverBackgroundColor: INDIGO,
                borderRadius: 4,
                categoryPercentage: .95,
                barPercentage: .72
            }]
        },
        options: baseOptions("No. of post")
    });

</script>