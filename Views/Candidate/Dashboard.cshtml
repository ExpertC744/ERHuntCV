@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Candidate Dashboard";
    ViewData["Panel"] = "Candidate";
    ViewData["UserName"] = "Candidate";
}

 @* Radhika30-09 *@
<link rel="stylesheet" href="~/css/Candidatedashboard.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/huntcv-table.css" asp-append-version="true" />
 
<div class="candidate-dashboard">

    <!-- Welcome -->
    <div class="welcome-banner">
        <div class="row align-items-center">
            <div class="col-md-8 welcome-content">
                <h2>Welcome back, Candidate 👋</h2>
                <p>
                    Track your applications, discover new opportunities
                    and take the next step in your career.
                </p>
            </div>

            <div class="col-md-4 text-md-end">
                <a href="#" class="profile-btn">
                    <i class="fas fa-user-edit"></i>
                    Complete Profile
                </a>
            </div>
        </div>
    </div>


    <!-- Statistics -->
    <div class="row">

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="stat-card">

                <div class="stat-icon icon-green">
                    <i class="fas fa-building"></i>
                </div>

                <div class="stat-title">
                    Total Organizations
                </div>

                <div class="stat-number">

                    @ViewBag.OrganizationRegistrationCount

                </div>

                <a asp-controller="Candidate"
                   asp-action="OrgList"
                   class="stat-link">
                    View Details
                    <i class="fas fa-arrow-right"></i>
                </a>

            </div>
        </div>


        <div class="col-xl-3 col-md-6 mb-4">
            <div class="stat-card">

                <div class="stat-icon icon-blue">
                    <i class="fas fa-briefcase"></i>
                </div>

                <div class="stat-title">
                    Open Job Openings
                </div>

                <div class="stat-number">
                    8
                </div>

                <div class="stat-bottom">
                    <span>+2</span> new opportunities
                </div>

            </div>
        </div>


        <div class="col-xl-3 col-md-6 mb-4">
            <div class="stat-card">

                <div class="stat-icon icon-orange">
                    <i class="fas fa-search"></i>
                </div>

                <div class="stat-title">
                    Top Searches
                </div>

                <div class="stat-number">
                    3
                </div>

                <div class="stat-bottom">
                    <span>+1</span> from last week
                </div>

            </div>
        </div>


        <div class="col-xl-3 col-md-6 mb-4">
            <div class="stat-card">

                <div class="stat-icon icon-purple">
                    <i class="fas fa-paper-plane"></i>
                </div>

                <div class="stat-title">
                    Applications Sent
                </div>

                <div class="stat-number">
                    25
                </div>

                <div class="stat-bottom">
                    <span>5</span> awaiting response
                </div>

            </div>
        </div>

    </div>

<!-- Monthly Analytics -->
<div class="row">

    <!-- Suitable Openings (area / line chart) -->
    <div class="col-lg-6 mb-4">
        <div class="chart-card">
            <div class="chart-card-header">
                <span class="chart-icon"><i class="fas fa-chart-area"></i></span>
                <h5>No. of suitable openings</h5>
            </div>
            <div class="chart-card-body">
                <canvas id="suitableOpeningsChart"
                        aria-label="Suitable openings monthly chart"></canvas>
            </div>
        </div>
    </div>

    <!-- Internship Posts (bar chart) -->
    <div class="col-lg-6 mb-4">
        <div class="chart-card">
            <div class="chart-card-header">
                <span class="chart-icon"><i class="fas fa-chart-bar"></i></span>
                <h5>Internship post from Organization</h5>
            </div>
            <div class="chart-card-body">
                <canvas id="internshipPostsChart"
                        aria-label="Internship posts monthly chart"></canvas>
            </div>
        </div>
    </div>

</div>




