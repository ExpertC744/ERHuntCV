@model List<SATraineeListM>

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Candidate Registration List";
    ViewData["Panel"] = "Organization";
    ViewData["UserName"] = "Organization";
}

@* External master files (add once in _DashboardLayout.cshtml instead, if you prefer):
   they are included here so this page works on its own. *@
<link rel="stylesheet" href="~/css/HuntCV-Table.css" />

<div class="container-fluid">

    <!-- ===== page head: title + back button ===== -->
    <div class="hc-page-head">
        <div>
            <h2 class="hc-page-title">Candidate Registration List</h2>
            <p class="hc-page-sub">View and manage registered candidates</p>
        </div>

        <a asp-controller="Organization"
           asp-action="Dashboard"
           class="hc-btn hc-btn-primary">
            <i class="fas fa-arrow-left"></i>  
        </a>
    </div>

    <!-- ===== master table card ===== -->
    <div class="hc-card">

        <div class="hc-card-header">
            <span class="hc-card-icon"><i class="fas fa-users"></i></span>
            <h5>Registered Candidates</h5>
        </div>

        <div class="hc-card-body">
            <div class="hc-table-scroll">

                @if (Model != null && Model.Count > 0)
                {
                    <!-- search + entries (10/25/50/100) + sort + paging come from HuntCV-Table.js -->
                    <table id="candidateTable"
                           class="table hc-table hc-nowrap hc-datatable"
                           data-page-length="10"
                           data-order-col="0"
                           data-order-dir="asc"
                           data-no-sort="5">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>First Name</th>
                                <th>Last Name</th>
                                <th>Mobile</th>
                                <th>Email</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.nID</td>
                                    <td>@item.sFName</td>
                                    <td>@item.sLName</td>
                                    <td>@item.sMobile</td>
                                    <td>@item.sEmail</td>
                                    <td>
                                        <button type="button"
                                                class="hc-btn hc-btn-primary hc-view-btn"
                                                data-id="@item.nID">
                                            <i class="fas fa-eye"></i>  
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <!-- no records: plain table (no hc-datatable) so the empty row isn't counted as data -->
                    <table id="candidateTable" class="table hc-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>First Name</th>
                                <th>Last Name</th>
                                <th>Mobile</th>
                                <th>Email</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="6" class="hc-empty">No candidate registrations found.</td>
                            </tr>
                        </tbody>
                    </table>
                }

            </div>
        </div>
    </div>

</div>

<script src="~/js/HuntCV-Table.js"></script>

 
