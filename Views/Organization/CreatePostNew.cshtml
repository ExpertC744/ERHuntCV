    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const country = document.getElementById("CountryID");
            const state = document.getElementById("StateID");
            const city = document.getElementById("CityID");

            // Load Country
            fetch('/Location/GetCountries')
                .then(response => response.json())
                .then(data => {

                    country.innerHTML =
                        '<option value="">Select Country</option>';

                    data.forEach(x => {

                        country.innerHTML +=
                            `<option value="${x.iso2}">
                                ${x.name}
                            </option>`;
                    });
                });


            // Country -> State
            country.addEventListener("change", function () {

                state.innerHTML =
                    '<option value="">Select State</option>';

                city.innerHTML =
                    '<option value="">Select City</option>';

                if (!this.value)
                    return;

                fetch(
                    '/Location/GetStates?countryCode=' +
                    encodeURIComponent(this.value)
                )
                .then(response => response.json())
                .then(data => {

                    data.forEach(x => {

                        state.innerHTML +=
                            `<option value="${x.stateCode}">
                                ${x.name}
                            </option>`;
                    });
                });
            });


            // State -> City
            state.addEventListener("change", function () {

                city.innerHTML =
                    '<option value="">Select City</option>';

                if (!this.value)
                    return;

                fetch(
                    '/Location/GetCities?countryCode=' +
                    encodeURIComponent(country.value) +
                    '&stateCode=' +
                    encodeURIComponent(this.value)
                )
                .then(response => response.json())
                .then(data => {

                    data.forEach(x => {

                        city.innerHTML +=
                            `<option value="${x.id}">
                                ${x.name}
                            </option>`;
                    });
                });
            });

        });
    </script>

