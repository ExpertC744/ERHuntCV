    <script>
    // Toggle open / close
    function toggleSkill(titleEl) {
        const box = titleEl.closest(".skill-box");
        const isOpen = box.classList.toggle("open");
        titleEl.setAttribute("aria-expanded", isOpen);
    }

    // Update "x selected" counters
    function updateSkillCounts() {
        const map = {
            medicalSkillsContainer: "medicalCount",
            technicalSkillsContainer: "technicalCount",
            nonTechnicalSkillsContainer: "nonTechnicalCount"
        };

        Object.keys(map).forEach(function (containerId) {
            const count = document.querySelectorAll(
                "#" + containerId + " input[type='checkbox']:checked"
            ).length;
            document.getElementById(map[containerId]).textContent =
                count + " selected";
        });
    }

    document.addEventListener("change", function (e) {
        if (e.target.matches(".skill-body input[type='checkbox']")) {
            updateSkillCounts();
        }
    });
</script>

