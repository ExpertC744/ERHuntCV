@model ERHuntCV.Models.OrgProfileM

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Edit Profile";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

 <link rel="stylesheet"
       href="~/css/EditProfile.css" />


<div class="ep-page">
    <div class="ep-inner">

        <!-- HEADER -->
        <div class="ep-header">

            <div class="ep-eyebrow">Organization Profile</div>

            <h1>Edit Profile</h1>

            <p>
                Keep your organization details up to date.
                <span class="ep-orgid">Organization ID : @Model.nOrgID</span>
            </p>

        </div>


        @if (TempData["SuccessMessage"] != null)
        {
            <div class="ep-alert ep-success">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="ep-alert ep-error">
                @TempData["ErrorMessage"]
            </div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="ep-alert ep-error">
                <strong>Please correct the following errors:</strong>
                <div asp-validation-summary="All"></div>
            </div>
        }


        <form asp-controller="Organization"
              asp-action="EditProfile"
              method="post"
              enctype="multipart/form-data"
              class="ep-form">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="nID" />
            <input type="hidden" asp-for="nOrgID" />
            <input type="hidden" asp-for="sCompanyLogo" />


            <!-- =============================================
                 ORGANIZATION DETAILS (READ ONLY)
            ============================================== -->

            <section class="ep-section">

                <div class="ep-section-head">
                    <div class="ep-icon">🏢</div>
                    <div>
                        <h2>Organization Details</h2>
                        <p class="ep-sub">Registered details — read only</p>
                    </div>
                </div>

                <div class="ep-grid">

                    <div class="ep-field">
                        <label>Organization Name</label>
                        <input asp-for="sOrganizationName" class="form-control" readonly />
                        <span asp-validation-for="sOrganizationName" class="validation-message"></span>
                    </div>

                    <div class="ep-field">
                        <label>Designation</label>
                        <input asp-for="sDesignation" class="form-control" readonly />
                        <span asp-validation-for="sDesignation" class="validation-message"></span>
                    </div>

                    <div class="ep-field">
                        <label>Contact No.</label>
                        <input asp-for="sMobile" class="form-control" readonly />
                        <span asp-validation-for="sMobile" class="validation-message"></span>
                    </div>

                    <div class="ep-field">
                        <label>Verification Email</label>
                        <input asp-for="sOrganizationEmail" class="form-control" type="email" readonly />
                        <span asp-validation-for="sOrganizationEmail" class="validation-message"></span>
                    </div>

                </div>

            </section>


            <!-- =============================================
                 PERSONAL & LOGO
            ============================================== -->

            <section class="ep-section">

                <div class="ep-section-head">
                    <div class="ep-icon">🖼</div>
                    <div>
                        <h2>Profile &amp; Branding</h2>
                        <p class="ep-sub">Date of birth and company logo</p>
                    </div>
                </div>

                <div class="ep-grid">

                    <div class="ep-field">
                        <label>Date of Birth</label>
                        <input asp-for="dDateOfBirth" class="form-control" type="date" />
                        <span asp-validation-for="dDateOfBirth" class="validation-message"></span>
                    </div>

                    <div class="ep-field ep-span-2">
                        <label>Company Logo</label>
                        <input type="file"
                               id="companyLogo"
                               name="CompanyLogo"
                               class="ep-file"
                               accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                        <span class="ep-note">JPG, JPEG, PNG or WEBP. Maximum 5 MB.</span>
                        <span id="logoError" class="validation-message"></span>
                    </div>

                    <div class="ep-field">
                        <label>Logo Preview</label>
                        <div class="ep-preview">

                            <span class="logo-size">100 x 100</span>

                            @if (!string.IsNullOrWhiteSpace(Model.sCompanyLogo))
                            {
                                <img src="@Url.Content("~/uploads/organization/" + Model.sCompanyLogo)"
                                     id="logoPreview"
                                     class="logo-preview"
                                     alt="Company Logo" />
                            }
                            else
                            {
                                <img src=""
                                     id="logoPreview"
                                     class="logo-preview"
                                     alt="Company Logo"
                                     style="display:none;" />
                            }

                        </div>
                    </div>

                </div>

            </section>


            <!-- =============================================
                 COMPANY DETAILS
            ============================================== -->

            <section class="ep-section">

                <div class="ep-section-head">
                    <div class="ep-icon">📋</div>
                    <div>
                        <h2>Company Details</h2>
                        <p class="ep-sub">Address, registration and strength</p>
                    </div>
                </div>

                <div class="ep-grid">

                    <div class="ep-field ep-span-2">
                        <label>Company Address <span class="ep-req">*</span></label>
                        <textarea asp-for="sCompanyAddress"
                                  class="form-control"
                                  placeholder="Enter company address"></textarea>
                        <span asp-validation-for="sCompanyAddress" class="validation-message"></span>
                    </div>

                    <div class="ep-field">
                        <label>Establishment Year <span class="ep-req">*</span></label>
                        <input asp-for="nEstablishmentYear"
                               class="form-control"
                               type="number"
                               min="1800"
                               max="@DateTime.Now.Year"
                               placeholder="e.g. 2002" />
                        <span asp-validation-for="nEstablishmentYear" class="validation-message"></span>
                    </div>

                    <div class="ep-field">
                        <label>Current Employee Strength <span class="ep-req">*</span></label>
                        <input asp-for="nEmployeeStrength"
                               class="form-control"
                               maxlength="100"
                               placeholder="Example: 1-10" />
                        <span asp-validation-for="nEmployeeStrength" class="validation-message"></span>
                    </div>

                    <div class="ep-field ep-span-2">
                        <label>GST No.</label>
                        <input asp-for="sGSTNo"
                               class="form-control"
                               maxlength="50"
                               placeholder="Enter GST number" />
                        <span asp-validation-for="sGSTNo" class="validation-message"></span>
                    </div>

                    <div class="ep-field ep-span-2">
                        <label>CIN No.</label>
                        <input asp-for="sCINNo"
                               class="form-control"
                               maxlength="50"
                               placeholder="Enter CIN number" />
                        <span asp-validation-for="sCINNo" class="validation-message"></span>
                    </div>

                </div>

            </section>


            <!-- =============================================
                 SAVE BAR
            ============================================== -->

            <div class="ep-submit">

                <p>
                    Fields marked <strong style="color:#e5484d">*</strong> are required.
                </p>

                <button type="submit" class="save-btn">
                    Save Changes
                </button>

            </div>

        </form>

    </div>
</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const logoInput = document.getElementById("companyLogo");
            const logoPreview = document.getElementById("logoPreview");
            const logoError = document.getElementById("logoError");

            if (!logoInput || !logoPreview) {
                return;
            }

            logoInput.addEventListener("change", function (event) {

                const file = event.target.files[0];

                if (logoError) {
                    logoError.textContent = "";
                }

                if (!file) {
                    return;
                }

                const allowedTypes = ["image/jpeg", "image/png", "image/webp"];
                const allowedExtensions = [".jpg", ".jpeg", ".png", ".webp"];

                const fileName = file.name.toLowerCase();
                const extension = fileName.substring(fileName.lastIndexOf("."));

                if (!allowedTypes.includes(file.type) ||
                    !allowedExtensions.includes(extension)) {

                    if (logoError) {
                        logoError.textContent =
                            "Please select a JPG, JPEG, PNG or WEBP image.";
                    }

                    event.target.value = "";
                    return;
                }

                const maxSize = 5 * 1024 * 1024;

                if (file.size > maxSize) {

                    if (logoError) {
                        logoError.textContent =
                            "Company logo size cannot exceed 5 MB.";
                    }

                    event.target.value = "";
                    return;
                }

                const reader = new FileReader();

                reader.onload = function (e) {
                    logoPreview.src = e.target.result;
                    logoPreview.style.display = "block";
                };

                reader.readAsDataURL(file);

            });

        });

    </script>

}