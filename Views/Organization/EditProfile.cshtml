@model ERHuntCV.Models.OrgProfileM

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Edit Profile";
}

<style>

    /* =========================================================
               MAIN CONTAINER
               ========================================================= */

    .profile-container {
        width: 100%;
        padding: 25px 16px;
        background: #fff;
        box-sizing: border-box;
    }


    /* =========================================================
               PAGE TITLE
               ========================================================= */

    .profile-title {
        font-size: 30px;
        font-weight: 600;
        color: #142238;
        margin: 0;
    }


    .organization-id {
        font-size: 18px;
        color: #718096;
        margin-top: 10px;
        margin-bottom: 32px;
    }


    /* =========================================================
               PROFILE GRID
               ========================================================= */

    .profile-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 30px;
    }


    /* =========================================================
               PROFILE CARD
               ========================================================= */

    .profile-card {
        background: #d3d3d3;
        border: 1px solid #b9b9b9;
        border-radius: 7px;
        overflow: hidden;
        min-height: 142px;
        box-sizing: border-box;
    }


    /* =========================================================
               CARD LABEL
               ========================================================= */

    .card-label {
        padding: 24px 20px 20px;
        font-size: 20px;
        color: #142238;
        min-height: 72px;
        border-bottom: 1px solid #b9b9b9;
        box-sizing: border-box;
    }


    .required {
        color: red;
    }


   
    .card-body {
        padding: 10px 20px 12px;
    }



    .form-control {
        width: 100%;
        height: 47px;
        border: 1px solid #ddd;
        border-radius: 8px;
        background: #fff;
        padding: 0 15px;
        font-size: 18px;
        color: #344054;
        outline: none;
        box-sizing: border-box;
    }


        .form-control:focus {
            border-color: #999;
            box-shadow: none;
        }


    

        .form-control[readonly] {
            background: #f5f5f5;
            color: #667085;
            cursor: not-allowed;
        }


    

    textarea.form-control {
        height: 90px;
        padding-top: 12px;
        resize: vertical;
    }

    .file-input {
        width: 100%;
        height: 47px;
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 17px;
        color: #344054;
        box-sizing: border-box;
    }


        .file-input::file-selector-button {
            height: 45px;
            padding: 0 15px;
            margin-right: 15px;
            border: none;
            border-right: 1px solid #ddd;
            background: #f1f1f1;
            color: #344054;
            font-size: 17px;
            cursor: pointer;
        }


    .logo-preview-body {
        min-height: 90px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 20px;
        box-sizing: border-box;
    }


    .logo-size {
        color: #999;
        font-size: 12px;
    }


    .logo-preview {
        width: 70px;
        height: 70px;
        object-fit: contain;
        border-radius: 5px;
        background: #fff;
        border: 1px solid #ddd;
    }


    .field-note {
        color: #666;
        font-size: 12px;
        margin-top: 5px;
    }



    .validation-message {
        color: red;
        font-size: 13px;
        margin-top: 4px;
        display: block;
    }



    .success-message {
        background: #d1e7dd;
        color: #0f5132;
        border: 1px solid #badbcc;
        padding: 10px 15px;
        border-radius: 5px;
        margin-bottom: 20px;
    }


    .error-message {
        background: #f8d7da;
        color: #842029;
        border: 1px solid #f5c2c7;
        padding: 10px 15px;
        border-radius: 5px;
        margin-bottom: 20px;
    }


    .save-container {
        margin-top: 30px;
        margin-bottom: 30px;
    }


    .save-btn {
        padding: 10px 25px;
        border: 1px solid #999;
        border-radius: 4px;
        background: #f5f5f5;
        color: #111;
        font-size: 18px;
        cursor: pointer;
    }


        .save-btn:hover {
            background: #e8e8e8;
        }


    @@media (max-width: 1200px) {

        .profile-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }


    @@media (max-width: 700px) {

        .profile-grid {
            grid-template-columns: 1fr;
        }

        .profile-title {
            font-size: 25px;
        }

        .organization-id {
            font-size: 16px;
        }
    }

</style>


<div class="profile-container">


    <h1 class="profile-title">
        Edit Profile
    </h1>


    <div class="organization-id">
        Organization ID : @Model.nOrgID
    </div>


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="success-message">
            @TempData["SuccessMessage"]
        </div>
    }


    @if (TempData["ErrorMessage"] != null)
    {
        <div class="error-message">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="error-message">

            <strong>Please correct the following errors:</strong>

            <div asp-validation-summary="All"></div>

        </div>
    }


    <form asp-controller="Organization"
          asp-action="EditProfile"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()



        <input type="hidden"
               asp-for="nID" />

        <input type="hidden"
               asp-for="nOrgID" />

        <input type="hidden"
               asp-for="sCompanyLogo" />


        <div class="profile-grid">


            <div class="profile-card">

                <div class="card-label">
                    Organization Name
                </div>

                <div class="card-body">

                    <input asp-for="sOrganizationName"
                           class="form-control"
                           readonly />

                    <span asp-validation-for="sOrganizationName"
                          class="validation-message">
                    </span>

                </div>

            </div>



            <div class="profile-card">

                <div class="card-label">
                    Designation
                </div>

                <div class="card-body">

                    <input asp-for="sDesignation"
                           class="form-control"
                           readonly />

                    <span asp-validation-for="sDesignation"
                          class="validation-message">
                    </span>

                </div>

            </div>


            <div class="profile-card">

                <div class="card-label">
                    Contact No.
                </div>

                <div class="card-body">

                    <input asp-for="sMobile"
                           class="form-control"
                           readonly />

                    <span asp-validation-for="sMobile"
                          class="validation-message">
                    </span>

                </div>

            </div>



            <div class="profile-card">

                <div class="card-label">
                    Verification Email
                </div>

                <div class="card-body">

                    <input asp-for="sOrganizationEmail"
                           class="form-control"
                           type="email"
                           readonly />

                    <span asp-validation-for="sOrganizationEmail"
                          class="validation-message">
                    </span>

                </div>

            </div>



            <div class="profile-card">

                <div class="card-label">
                    Date of Birth
                </div>

                <div class="card-body">

                    <input asp-for="dDateOfBirth"
                           class="form-control"
                           type="date" />

                    <span asp-validation-for="dDateOfBirth"
                          class="validation-message">
                    </span>

                </div>

            </div>


            <div class="profile-card">

                <div class="card-label">
                    Company Logo
                </div>

                <div class="card-body">

                    <input type="file"
                           id="companyLogo"
                           name="CompanyLogo"
                           class="file-input"
                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />

                    <div class="field-note">
                        JPG, JPEG, PNG or WEBP. Maximum 5 MB.
                    </div>

                    <span id="logoError"
                          class="validation-message">
                    </span>

                </div>

            </div>



            <div class="profile-card">

                <div class="card-label">
                    Logo Preview
                </div>

                <div class="logo-preview-body">

                    <span class="logo-size">
                        100 x 100
                    </span>


                    @if (!string.IsNullOrWhiteSpace(Model.sCompanyLogo))
                    {
                        <img src="@Url.Content("~/uploads/organization/" + Model.sCompanyLogo)"
                             id="logoPreview"
                             class="logo-preview"
                             alt="Company Logo" />
                    }
                    else
                    {
                        <img src=""
                             id="logoPreview"
                             class="logo-preview"
                             alt="Company Logo"
                             style="display:none;" />
                    }

                </div>

            </div>


            <div class="profile-card">

                <div class="card-label">

                    Company Address

                    <span class="required">*</span>

                </div>

                <div class="card-body">

                    <textarea asp-for="sCompanyAddress"
                              class="form-control"
                              placeholder="Enter company address"></textarea>

                    <span asp-validation-for="sCompanyAddress"
                          class="validation-message">
                    </span>

                </div>

            </div>



            <div class="profile-card">

                <div class="card-label">

                    Establishment Year

                    <span class="required">*</span>

                </div>

                <div class="card-body">

                    <input asp-for="nEstablishmentYear"
                           class="form-control"
                           type="number"
                           min="1800"
                           max="@DateTime.Now.Year"
                           placeholder="e.g. 2002" />

                    <span asp-validation-for="nEstablishmentYear"
                          class="validation-message">
                    </span>

                </div>

            </div>


            <div class="profile-card">

                <div class="card-label">
                    GST No.
                </div>

                <div class="card-body">

                    <input asp-for="sGSTNo"
                           class="form-control"
                           maxlength="50"
                           placeholder="Enter GST number" />

                    <span asp-validation-for="sGSTNo"
                          class="validation-message">
                    </span>

                </div>

            </div>



            <div class="profile-card">

                <div class="card-label">
                    CIN No.
                </div>

                <div class="card-body">

                    <input asp-for="sCINNo"
                           class="form-control"
                           maxlength="50"
                           placeholder="Enter CIN number" />

                    <span asp-validation-for="sCINNo"
                          class="validation-message">
                    </span>

                </div>

            </div>



            <div class="profile-card">

                <div class="card-label">

                    Current Employee Strength

                    <span class="required">*</span>

                </div>

                <div class="card-body">

                    <input asp-for="nEmployeeStrength"
                           class="form-control"
                           maxlength="100"
                           placeholder="Example: 1-10" />

                    <span asp-validation-for="nEmployeeStrength"
                          class="validation-message">
                    </span>

                </div>

            </div>


        </div>

        <div class="save-container">

            <button type="submit"
                    class="save-btn">
                Save
            </button>

        </div>

    </form>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />


    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const logoInput =
                document.getElementById("companyLogo");

            const logoPreview =
                document.getElementById("logoPreview");

            const logoError =
                document.getElementById("logoError");


            if (!logoInput || !logoPreview) {
                return;
            }


            logoInput.addEventListener("change", function (event) {

                const file =
                    event.target.files[0];


                // Clear previous error
                if (logoError) {
                    logoError.textContent = "";
                }

                if (!file) {
                    return;
                }
                const allowedTypes = [
                    "image/jpeg",
                    "image/png",
                    "image/webp"
                ];


                const allowedExtensions = [
                    ".jpg",
                    ".jpeg",
                    ".png",
                    ".webp"
                ];


                const fileName =
                    file.name.toLowerCase();

                const extension =
                    fileName.substring(
                        fileName.lastIndexOf(".")
                    );


                if (!allowedTypes.includes(file.type) ||
                    !allowedExtensions.includes(extension)) {

                    if (logoError) {
                        logoError.textContent =
                            "Please select a JPG, JPEG, PNG or WEBP image.";
                    }

                    event.target.value = "";

                    return;
                }


                const maxSize =
                    5 * 1024 * 1024;


                if (file.size > maxSize) {

                    if (logoError) {
                        logoError.textContent =
                            "Company logo size cannot exceed 5 MB.";
                    }

                    event.target.value = "";

                    return;
                }


                const reader =
                    new FileReader();


                reader.onload = function (e) {

                    logoPreview.src =
                        e.target.result;

                    logoPreview.style.display =
                        "block";
                };


                reader.readAsDataURL(file);

            });

        });

    </script>

}