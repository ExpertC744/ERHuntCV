<!-- =========================================================
     DATATABLE INITIALIZATION
========================================================= -->

<script>

    $(document).ready(function () {

    const table = new DataTable('#organizationJobsTable', {

    /* ================================================
    DEFAULT PAGE SIZE
    ================================================ */

    pageLength: 5,


    /* ================================================
    ENTRIES PER PAGE
    ================================================ */

    lengthMenu: [
    [5, 10, 25, 50],
    [5, 10, 25, 50]
    ],


    /* ================================================
    FEATURES
    ================================================ */

    searching: true,

    ordering: true,

    paging: true,

    info: true,


    /* ================================================
    DEFAULT SORT
    Posted Date = column 3
    ================================================ */

    order: [
    [3, 'desc']
    ],


    /* ================================================
    PAGINATION
    ================================================ */

    pagingType: 'simple_numbers',


    /* ================================================
    LANGUAGE
    ================================================ */

    language: {

    search: '',

    searchPlaceholder: 'Search jobs...',

    lengthMenu: 'Show _MENU_ entries',

    info: 'Showing _START_ to _END_ of _TOTAL_ jobs',

    infoEmpty: 'Showing 0 to 0 of 0 jobs',

    zeroRecords: 'No matching jobs found',

    emptyTable: 'No job openings available',

    paginate: {

    previous: '‹',

    next: '›'

    }

    },


    /* ================================================
    CALLBACK
    Fix table width after initialization
    ================================================ */

    initComplete: function () {

    $('#organizationJobsTable_wrapper')
    .css('width', '100%');

    }

    });


    /* =====================================================
    SEARCH INPUT
    ===================================================== */

    $('#organizationJobsTable_wrapper .dt-search input')
    .attr('placeholder', 'Search jobs...');


    /* =====================================================
    RESPONSIVE WINDOW RESIZE
    ===================================================== */

    $(window).on('resize', function () {

    table.columns.adjust();

    });

    });

</script>

