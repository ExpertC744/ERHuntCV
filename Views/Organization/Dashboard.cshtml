@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Organization Dashboard";
    ViewData["Panel"] = "Organization";
    //ViewData["UserName"] = "Organization";
}

<!-- =========================================================
     DATATABLE CSS
========================================================= -->
<link rel="stylesheet"
      href="https://cdn.datatables.net/2.3.3/css/dataTables.dataTables.min.css" />

      @* Radhika30-09 *@
<link rel="stylesheet" href="~/css/OrganizationDashboard.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/HuntCV-Table.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/HuntCV-Chart.css" asp-append-version="true" />

 

<!-- =========================================================
     DASHBOARD
========================================================= -->

<div class="container-fluid organization-dashboard">

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="org-page-header">
        <div class="org-page-title">
            <h2>
                Organization Dashboard
            </h2>
            <p>
                Manage your jobs, candidates and hiring activities.
            </p>
        </div>
        <a href="#" class="post-job-btn">
            <i class="fas fa-plus"></i>
            Post New Job
        </a>
    </div>


    <!-- =====================================================
         STATISTICS
    ====================================================== -->

    <div class="row g-4 mb-4">

        <!-- POSTED JOBS -->

        <div class="col-xl-3 col-lg-6 col-md-6">

            <div class="org-stat-card">

                <div class="stat-top">

                    <div class="stat-icon green">
                        <i class="fas fa-briefcase"></i>
                    </div>

                    <span class="stat-growth">
                        <i class="fas fa-arrow-up"></i>
                        12%
                    </span>

                </div>

                <span class="stat-label">
                    Total Trainees
                </span>

                <div class="stat-number">
                    @ViewBag.TraineeRegistrationCount
                </div>

                <a asp-controller="Organization"
                   asp-action="TraineeList"
                   class="stat-link">
                    View Details
                    <i class="fas fa-arrow-right"></i>
                </a>

            </div>

        </div>


        <!-- APPLICATIONS -->

        <div class="col-xl-3 col-lg-6 col-md-6">

            <div class="org-stat-card">

                <div class="stat-top">

                    <div class="stat-icon blue">
                        <i class="fas fa-file-lines"></i>
                    </div>

                    <span class="stat-growth">
                        <i class="fas fa-arrow-up"></i>
                        18%
                    </span>

                </div>

                <span class="stat-label">
                    Total Organizations
                </span>

                <div class="stat-number">

                    @ViewBag.OrganizationRegistrationCount

                </div>

                <a asp-controller="Organization"
                   asp-action="OrgList"
                   class="stat-link">
                    View Details
                    <i class="fas fa-arrow-right"></i>
                </a>
            </div>

        </div>


        <!-- SHORTLISTED -->

        <div class="col-xl-3 col-lg-6 col-md-6">

            <div class="org-stat-card">

                <div class="stat-top">

                    <div class="stat-icon purple">
                        <i class="fas fa-user-check"></i>
                    </div>

                    <span class="stat-growth">
                        <i class="fas fa-arrow-up"></i>
                        8%
                    </span>

                </div>

                <span class="stat-label">
                    Top Search
                </span>

                <div class="stat-number">
                    @ViewBag.TopSearch
                </div>

                <a asp-controller="Organization"
                   asp-action="OrgTopSearch"
                   class="stat-link">
                    View Candidates
                    <i class="fas fa-arrow-right"></i>
                </a>

            </div>

        </div>


        <!-- INTERVIEWS -->

        <div class="col-xl-3 col-lg-6 col-md-6">

            <div class="org-stat-card">

                <div class="stat-top">

                    <div class="stat-icon orange">
                        <i class="fas fa-calendar-check"></i>
                    </div>

                    <span class="stat-growth">
                        <i class="fas fa-arrow-up"></i>
                        5%
                    </span>

                </div>

                <span class="stat-label">
                    Trainees Applied Your Post
                </span>

                <div class="stat-number">
                    @ViewBag.TraineesApplied
                </div>

                <a asp-controller="Organization"
                   asp-action="AppliedTrainees"
                   class="stat-link">
                    View Interviews
                    <i class="fas fa-arrow-right"></i>
                </a>
            </div>

        </div>

    </div>

   @* =========================== BLOCK A ===========================
   TRAINEE CHARTS  (master chart)
   ============================================================== *@

<div class="row g-4 mb-4">

    <!-- CHART 1 : eligible trainees (area / line) -->
    <div class="col-xl-6 col-lg-6 col-md-12">
        <div class="hc-chart-card">

            <div class="hc-chart-head">
                <div>
                    <div class="hc-chart-title">No. of Trainee Eligible for Internship</div>
                    <div class="hc-chart-number">@ViewBag.InternshipEligibleCount</div>
                    <div class="hc-chart-sub">Current eligible trainees</div>
                </div>
                <div class="hc-chart-icon"><i class="fas fa-user-graduate"></i></div>
            </div>

            <div class="hc-chart-body">
                @* data-values = one number per month (last N months are labelled automatically).
                   Later: data-values="@Json.Serialize(ViewBag.EligibleMonthly)" *@
                <canvas class="hc-chart"
                        data-type="line"
                        data-values="[0,0,2,3,5,4,8,9,12,10]"
                        data-label="No. of eligible trainees"
                        data-y-title="No. of trainees"></canvas>
            </div>

            <div class="hc-chart-foot">
                <i class="fas fa-chart-line"></i> Monthly eligible trainee trend
            </div>

        </div>
    </div>

    <!-- CHART 2 : registrations per month (bar) -->
    <div class="col-xl-6 col-lg-6 col-md-12">
        <div class="hc-chart-card">

            <div class="hc-chart-head">
                <div>
                    <div class="hc-chart-title">Total Registration Per Month</div>
                    <div class="hc-chart-number">@ViewBag.TraineeRegistrationCount</div>
                    <div class="hc-chart-sub">Total trainee registrations</div>
                </div>
                <div class="hc-chart-icon"><i class="fas fa-building"></i></div>
            </div>

            <div class="hc-chart-body">
                <canvas class="hc-chart"
                        data-type="bar"
                        data-values="[4,9,16,15,40,12,21,8,14,18]"
                        data-label="No. of registrations"
                        data-y-title="No. of registrations"></canvas>
            </div>

            <div class="hc-chart-foot">
                <i class="fas fa-chart-line"></i> Monthly trainee registration trend
            </div>

        </div>
    </div>

</div>

