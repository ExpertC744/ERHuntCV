@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Organization Dashboard";
    ViewData["Panel"] = "Organization";
    //ViewData["UserName"] = "Organization";
}

<!-- =========================================================
     DATATABLE CSS
========================================================= -->
<link rel="stylesheet"
      href="https://cdn.datatables.net/2.3.3/css/dataTables.dataTables.min.css" />

<style>

    /* =========================================================
                       GLOBAL
                    ========================================================= */

    * {
        box-sizing: border-box;
    }

    .organization-dashboard {
        width: 100%;
        max-width: 100%;
        padding: 10px;
        color: #344054;
        overflow-x: hidden;
    }


    /* =========================================================
                       PAGE HEADER
                    ========================================================= */

    .org-page-header {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
    }

    .org-page-title {
        min-width: 0;
    }

        .org-page-title h2 {
            margin: 0;
            color: #1f2937;
            font-size: 30px;
            font-weight: 700;
            line-height: 1.3;
        }

        .org-page-title p {
            margin: 7px 0 0;
            color: #98a2b3;
            font-size: 15px;
            line-height: 1.5;
        }

    .post-job-btn {
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 44px;
        padding: 12px 19px;
        background: #1e7b67;
        color: #ffffff;
        border-radius: 10px;
        text-decoration: none;
        font-size: 15px;
        font-weight: 600;
        box-shadow: 0 7px 20px rgba(30,123,103,.18);
        transition: all .25s ease;
        white-space: nowrap;
    }

        .post-job-btn:hover {
            background: #176553;
            color: #ffffff;
            transform: translateY(-2px);
        }


    /* =========================================================
                       STAT CARDS
                    ========================================================= */

    .org-stat-card {
        position: relative;
        height: 100%;
        min-height: 210px;
        padding: 21px;
        background: #ffffff;
        border: 1px solid #edf0f2;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0,0,0,.035);
        transition: all .3s ease;
    }

        .org-stat-card:hover {
            transform: translateY(-5px);
            border-color: #d5e9e3;
            box-shadow: 0 15px 35px rgba(30,123,103,.10);
        }

        .org-stat-card::after {
            content: "";
            position: absolute;
            width: 110px;
            height: 110px;
            right: -45px;
            bottom: -45px;
            border-radius: 50%;
            background: #f1faf7;
            pointer-events: none;
        }

    .stat-top {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        min-width: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        font-size: 20px;
    }

        .stat-icon.green {
            background: #e8f5f1;
            color: #1e7b67;
        }

        .stat-icon.blue {
            background: #edf5ff;
            color: #3978c8;
        }

        .stat-icon.purple {
            background: #f2edff;
            color: #7655c9;
        }

        .stat-icon.orange {
            background: #fff3e8;
            color: #d77b2b;
        }

    .stat-growth {
        padding: 5px 9px;
        border-radius: 20px;
        background: #e8f7f2;
        color: #1e7b67;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .stat-label {
        display: block;
        position: relative;
        z-index: 2;
        margin-top: 19px;
        color: #667085;
        font-size: 15px;
    }

    .stat-number {
        position: relative;
        z-index: 2;
        margin-top: 3px;
        color: #1f2937;
        font-size: 32px;
        font-weight: 700;
    }

    .stat-description {
        position: relative;
        z-index: 2;
        margin-top: 2px;
        color: #98a2b3;
        font-size: 13px;
    }

    .stat-link {
        position: relative;
        z-index: 2;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 17px;
        color: #1e7b67;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
    }

        .stat-link:hover {
            color: #145c4c;
        }


    /* =========================================================
                       COMMON PANEL
                    ========================================================= */

    .org-panel {
        width: 100%;
        height: 100%;
        background: #ffffff;
        border: 1px solid #edf0f2;
        border-radius: 16px;
        box-shadow: 0 5px 20px rgba(0,0,0,.035);
        overflow: hidden;
    }

    .panel-header {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 19px 21px;
        border-bottom: 1px solid #edf0f2;
        background: #ffffff;
    }

        .panel-header > div {
            min-width: 0;
        }

        .panel-header h5 {
            margin: 0;
            color: #1f2937;
            font-size: 17px;
            font-weight: 700;
        }

        .panel-header p {
            margin: 5px 0 0;
            color: #98a2b3;
            font-size: 13px;
        }

    .view-all {
        flex-shrink: 0;
        color: #1e7b67;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
    }

        .view-all:hover {
            color: #145c4c;
        }


    /* =========================================================
                       RECENT APPLICATIONS
                    ========================================================= */

    .application-list {
        width: 100%;
        padding: 4px 21px;
    }

    .application-item {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 15px 0;
        border-bottom: 1px solid #f0f2f4;
    }

        .application-item:last-child {
            border-bottom: 0;
        }

    .candidate-avatar {
        width: 43px;
        height: 43px;
        min-width: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: #e8f5f1;
        color: #1e7b67;
        font-size: 14px;
        font-weight: 700;
    }

    .candidate-info {
        flex: 1;
        min-width: 0;
    }

        .candidate-info h6 {
            margin: 0;
            color: #344054;
            font-size: 14px;
            font-weight: 700;
        }

        .candidate-info span {
            display: block;
            margin-top: 4px;
            color: #98a2b3;
            font-size: 12px;
        }

    .applied-job {
        min-width: 140px;
    }

        .applied-job small {
            display: block;
            margin-bottom: 3px;
            color: #98a2b3;
            font-size: 10px;
            font-weight: 600;
        }

        .applied-job strong {
            color: #475467;
            font-size: 13px;
        }

    .application-status {
        min-width: 82px;
        padding: 6px 9px;
        border-radius: 20px;
        text-align: center;
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap;
    }

    .status-new {
        background: #edf5ff;
        color: #3978c8;
    }

    .status-reviewing {
        background: #fff4e8;
        color: #d77b2b;
    }

    .status-shortlisted {
        background: #e8f5f1;
        color: #1e7b67;
    }


    /* =========================================================
                       QUICK ACTIONS
                    ========================================================= */

    .quick-actions {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 11px;
        padding: 17px;
    }

    .quick-action {
        display: flex;
        align-items: center;
        gap: 9px;
        min-height: 68px;
        padding: 11px;
        border: 1px solid #edf0f2;
        border-radius: 11px;
        text-decoration: none;
        transition: all .25s ease;
        min-width: 0;
    }

        .quick-action:hover {
            background: #f8fcfa;
            border-color: #cde5de;
            transform: translateY(-2px);
        }

    .quick-icon {
        width: 38px;
        height: 38px;
        min-width: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #e8f5f1;
        color: #1e7b67;
        font-size: 15px;
    }

    .quick-action > div:last-child {
        min-width: 0;
    }

    .quick-action strong {
        display: block;
        color: #344054;
        font-size: 13px;
    }

    .quick-action small {
        display: block;
        margin-top: 3px;
        color: #98a2b3;
        font-size: 11px;
    }


    /* =========================================================
                       JOB TABLE CONTAINER
                    ========================================================= */

    .jobs-table-container {
        width: 100%;
        padding: 20px;
        background: #ffffff;
        box-sizing: border-box;
    }

    .jobs-table-scroll {
        width: 100%;
        max-width: 100%;
        overflow-x: auto;
        overflow-y: hidden;
        background: #ffffff;
        -webkit-overflow-scrolling: touch;
    }

    #organizationJobsTable_wrapper {
        width: 100%;
        max-width: 100%;
        background: #ffffff !important;
    }


        /* =========================================================
                       DATATABLE TOP TOOLBAR
                    ========================================================= */

        #organizationJobsTable_wrapper .dt-layout-row:first-child {
            width: 100%;
            display: flex !important;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            margin: 0 0 16px 0 !important;
            padding: 0 !important;
            background: #ffffff !important;
        }

        #organizationJobsTable_wrapper .dt-layout-start,
        #organizationJobsTable_wrapper .dt-layout-end {
            display: flex;
            align-items: center;
            min-width: 0;
        }

        #organizationJobsTable_wrapper .dt-layout-start {
            justify-content: flex-start;
        }

        #organizationJobsTable_wrapper .dt-layout-end {
            justify-content: flex-end;
            margin-left: auto;
        }


        /* =========================================================
                       LENGTH / ENTRIES
                    ========================================================= */

        #organizationJobsTable_wrapper .dt-length {
            display: flex;
            align-items: center;
            gap: 7px;
            margin: 0 !important;
            color: #667085;
            font-size: 13px;
            white-space: nowrap;
        }

            #organizationJobsTable_wrapper .dt-length label {
                color: #667085;
                font-size: 13px;
            }

            #organizationJobsTable_wrapper .dt-length select {
                width: 70px !important;
                min-width: 70px !important;
                height: 38px !important;
                margin: 0 !important;
                padding: 0 8px !important;
                border: 1px solid #dfe5e8 !important;
                border-radius: 9px !important;
                background: #ffffff !important;
                color: #344054 !important;
                outline: none !important;
                font-size: 13px !important;
                cursor: pointer;
            }

                #organizationJobsTable_wrapper .dt-length select:hover {
                    border-color: #c7d8d3 !important;
                }

                #organizationJobsTable_wrapper .dt-length select:focus {
                    border-color: #1e7b67 !important;
                    box-shadow: 0 0 0 3px rgba(30,123,103,.07) !important;
                }


        /* =========================================================
                       SEARCH
                    ========================================================= */

        #organizationJobsTable_wrapper .dt-search {
            position: relative;
            display: flex;
            align-items: center;
            width: 280px;
            margin: 0 !important;
        }

            #organizationJobsTable_wrapper .dt-search label {
                display: none !important;
            }

            #organizationJobsTable_wrapper .dt-search::before {
                content: "\f002";
                position: absolute;
                left: 13px;
                top: 50%;
                transform: translateY(-50%);
                font-family: "Font Awesome 6 Free";
                font-weight: 900;
                color: #98a2b3;
                font-size: 13px;
                z-index: 2;
                pointer-events: none;
            }

            #organizationJobsTable_wrapper .dt-search input {
                width: 100% !important;
                height: 38px !important;
                margin: 0 !important;
                padding: 0 13px 0 35px !important;
                border: 1px solid #dfe5e8 !important;
                border-radius: 9px !important;
                background: #ffffff !important;
                color: #344054 !important;
                font-size: 13px !important;
                outline: none !important;
                box-shadow: none !important;
                box-sizing: border-box !important;
            }

                #organizationJobsTable_wrapper .dt-search input::placeholder {
                    color: #98a2b3;
                    opacity: 1;
                }

                #organizationJobsTable_wrapper .dt-search input:focus {
                    border-color: #1e7b67 !important;
                    box-shadow: 0 0 0 3px rgba(30,123,103,.08) !important;
                }


    /* =========================================================
                       TABLE
                    ========================================================= */

    #organizationJobsTable,
    #organizationJobsTable.dataTable {
        width: 100% !important;
        min-width: 760px !important;
        margin: 0 !important;
        border-collapse: separate !important;
        border-spacing: 0;
        border: 1px solid #edf0f2 !important;
        border-radius: 11px;
        background: #ffffff !important;
        overflow: hidden;
    }


        /* =========================================================
                       TABLE HEADER
                    ========================================================= */

        #organizationJobsTable thead,
        #organizationJobsTable.dataTable thead,
        #organizationJobsTable thead tr,
        #organizationJobsTable.dataTable thead tr {
            background: #ffffff !important;
        }

            #organizationJobsTable thead th,
            #organizationJobsTable.dataTable thead th {
                height: 48px !important;
                padding: 0 14px !important;
                background: #ffffff !important;
                background-image: none !important;
                border-bottom: 1px solid #edf0f2 !important;
                color: #667085 !important;
                font-size: 11px !important;
                font-weight: 700 !important;
                text-align: center !important;
                vertical-align: middle !important;
                text-transform: uppercase;
                letter-spacing: .4px;
                white-space: nowrap;
            }


        /* =========================================================
                       TABLE BODY
                    ========================================================= */

        #organizationJobsTable tbody,
        #organizationJobsTable.dataTable tbody {
            background: #ffffff !important;
        }

            #organizationJobsTable tbody tr,
            #organizationJobsTable.dataTable tbody tr,
            #organizationJobsTable tbody tr.odd,
            #organizationJobsTable tbody tr.even {
                background: #ffffff !important;
                background-image: none !important;
                box-shadow: none !important;
            }

            #organizationJobsTable tbody td,
            #organizationJobsTable.dataTable tbody td {
                height: 65px !important;
                padding: 10px 14px !important;
                background: #ffffff !important;
                background-image: none !important;
                border-bottom: 1px solid #f0f2f4 !important;
                color: #475467 !important;
                font-size: 13px !important;
                text-align: center !important;
                vertical-align: middle !important;
                white-space: nowrap;
            }


        /* =========================================================
                       REMOVE STRIPING
                    ========================================================= */

        #organizationJobsTable.dataTable > tbody > tr:nth-child(odd),
        #organizationJobsTable.dataTable > tbody > tr:nth-child(even),
        #organizationJobsTable.dataTable > tbody > tr:nth-child(odd) > td,
        #organizationJobsTable.dataTable > tbody > tr:nth-child(even) > td {
            background-color: #ffffff !important;
            background-image: none !important;
        }


        /* =========================================================
                       TABLE HOVER
                    ========================================================= */

        #organizationJobsTable tbody tr:hover td,
        #organizationJobsTable.dataTable tbody tr:hover td {
            background: #fafffd !important;
        }


        /* =========================================================
                       FIRST COLUMN
                    ========================================================= */

        #organizationJobsTable thead th:first-child,
        #organizationJobsTable.dataTable thead th:first-child,
        #organizationJobsTable tbody td:first-child,
        #organizationJobsTable.dataTable tbody td:first-child {
            text-align: left !important;
        }


        /* =========================================================
                       LAST ROW
                    ========================================================= */

        #organizationJobsTable tbody tr:last-child td,
        #organizationJobsTable.dataTable tbody tr:last-child td {
            border-bottom: none !important;
        }


    /* =========================================================
                       JOB INFORMATION
                    ========================================================= */

    .job-info {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 10px;
        min-width: 220px;
        text-align: left;
    }

    .job-icon {
        width: 38px;
        height: 38px;
        min-width: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #e8f5f1;
        color: #1e7b67;
        font-size: 15px;
    }

    .job-info > div:last-child {
        min-width: 0;
    }

    .job-info strong {
        display: block;
        color: #344054;
        font-size: 13px;
        font-weight: 700;
        white-space: nowrap;
    }

    .job-info small {
        display: block;
        margin-top: 3px;
        color: #98a2b3;
        font-size: 11px;
        white-space: nowrap;
    }


    /* =========================================================
                       STATUS
                    ========================================================= */

    .job-status {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        min-width: 70px;
        padding: 6px 10px;
        border-radius: 20px;
        background: #e8f5f1;
        color: #1e7b67;
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap;
    }

        .job-status::before {
            content: "";
            width: 6px;
            height: 6px;
            min-width: 6px;
            border-radius: 50%;
            background: #1e7b67;
        }


    /* =========================================================
                       BOTTOM DATATABLE AREA
                    ========================================================= */

    #organizationJobsTable_wrapper .dt-layout-row:last-child {
        width: 100%;
        display: flex !important;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-top: 18px !important;
        padding: 0 !important;
        background: #ffffff !important;
    }

    #organizationJobsTable_wrapper .dt-info {
        padding: 0 !important;
        margin: 0 !important;
        color: #98a2b3;
        font-size: 12px;
        white-space: nowrap;
    }


    /* =========================================================
                       PAGINATION
                    ========================================================= */

    #organizationJobsTable_wrapper .dt-paging {
        display: flex !important;
        align-items: center !important;
        justify-content: flex-end !important;
        gap: 5px !important;
        padding: 0 !important;
        margin: 0 !important;
        background: #ffffff !important;
        white-space: nowrap;
    }

        #organizationJobsTable_wrapper .dt-paging .dt-paging-button {
            position: relative !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            min-width: 34px !important;
            width: auto !important;
            height: 34px !important;
            margin: 0 !important;
            padding: 0 10px !important;
            border: 1px solid #e1e6e8 !important;
            border-radius: 8px !important;
            background: #ffffff !important;
            background-image: none !important;
            color: #667085 !important;
            font-size: 13px !important;
            font-weight: 600 !important;
            line-height: 1 !important;
            text-align: center !important;
            box-shadow: none !important;
            outline: none !important;
            cursor: pointer !important;
            transition: all .2s ease !important;
        }

            #organizationJobsTable_wrapper .dt-paging
            .dt-paging-button:hover:not(.current):not(.disabled) {
                background: #e8f5f1 !important;
                border-color: #c7e2da !important;
                color: #1e7b67 !important;
                transform: translateY(-1px);
            }

            #organizationJobsTable_wrapper .dt-paging
            .dt-paging-button.current {
                background: #1e7b67 !important;
                border-color: #1e7b67 !important;
                color: #ffffff !important;
                font-weight: 700 !important;
                box-shadow: 0 4px 10px rgba(30,123,103,.18) !important;
            }

                #organizationJobsTable_wrapper .dt-paging
                .dt-paging-button.current:hover {
                    background: #176553 !important;
                    border-color: #176553 !important;
                    color: #ffffff !important;
                }

            #organizationJobsTable_wrapper .dt-paging
            .dt-paging-button.previous,
            #organizationJobsTable_wrapper .dt-paging
            .dt-paging-button.next {
                padding: 0 12px !important;
                background: #ffffff !important;
                border-color: #dfe5e8 !important;
                color: #475467 !important;
                font-size: 12px !important;
                font-weight: 600 !important;
            }

                #organizationJobsTable_wrapper .dt-paging
                .dt-paging-button.previous:hover:not(.disabled),
                #organizationJobsTable_wrapper .dt-paging
                .dt-paging-button.next:hover:not(.disabled) {
                    background: #e8f5f1 !important;
                    border-color: #c7e2da !important;
                    color: #1e7b67 !important;
                }

            #organizationJobsTable_wrapper .dt-paging
            .dt-paging-button.disabled {
                opacity: .45 !important;
                background: #ffffff !important;
                border-color: #e5e7eb !important;
                color: #98a2b3 !important;
                cursor: not-allowed !important;
                transform: none !important;
                box-shadow: none !important;
            }

        #organizationJobsTable_wrapper .dt-paging .ellipsis {
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            min-width: 28px !important;
            height: 34px !important;
            color: #98a2b3 !important;
            font-size: 13px !important;
            font-weight: 600 !important;
            background: transparent !important;
        }


    /* =========================================================
                       SCROLLBAR
                    ========================================================= */

    .jobs-table-scroll::-webkit-scrollbar {
        height: 6px;
    }

    .jobs-table-scroll::-webkit-scrollbar-track {
        background: #ffffff;
    }

    .jobs-table-scroll::-webkit-scrollbar-thumb {
        background: #cbded8;
        border-radius: 10px;
    }

        .jobs-table-scroll::-webkit-scrollbar-thumb:hover {
            background: #a9c8be;
        }

    div.dt-container div.dt-layout-row {
        display: flex !important;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        margin: .75em 0;
    }
    /* =========================================================
                       LARGE TABLET
                    ========================================================= */

    @@media (max-width: 1199px) {

        .organization-dashboard {
            padding: 8px;
        }

        .org-stat-card {
            min-height: 200px;
        }

        .job-info {
            min-width: 200px;
        }
    }


    /* =========================================================
                       TABLET - 991px
                    ========================================================= */

    @@media (max-width: 991px) {

        .org-page-header {
            align-items: flex-start;
        }

        .applied-job {
            display: none;
        }

        #organizationJobsTable_wrapper .dt-layout-row:first-child {
            flex-direction: column !important;
            align-items: stretch !important;
            gap: 12px !important;
        }

        #organizationJobsTable_wrapper .dt-layout-start,
        #organizationJobsTable_wrapper .dt-layout-end {
            width: 100% !important;
            margin: 0 !important;
        }

        #organizationJobsTable_wrapper .dt-layout-start {
            justify-content: flex-start;
        }

        #organizationJobsTable_wrapper .dt-layout-end {
            justify-content: flex-start;
