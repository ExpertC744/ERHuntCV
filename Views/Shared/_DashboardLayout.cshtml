            .superadmin-sidebar a.sidebar-link:hover,
            .superadmin-sidebar a.sidebar-link:active {
                color: #16816d;
                text-decoration: none;
            }


            /* =========================================================
            ICON
            ========================================================= */

            .superadmin-sidebar .menu-icon {
                color: #16816d;
                min-width: 45px;
                display: flex;
                align-items: center;
                justify-content: center;
            }


            /* =========================================================
            MENU TEXT
            ========================================================= */

            .superadmin-sidebar .menu-text {
                color: #16816d;
                font-size: 20px;
                font-weight: 500;
                flex: 1;
            }


            /* =========================================================
            ARROW
            ========================================================= */

            .superadmin-sidebar .menu-arrow {
                color: #16816d;
                margin-left: auto;
                display: flex;
                align-items: center;
                justify-content: center;
            }


            /* =========================================================
            DROPDOWN MENU
            ========================================================= */

            .superadmin-sidebar .sidebar-submenu {
                width: 100%;
                padding-left: 50px;
                padding-top: 5px;
                padding-bottom: 8px;
            }


                /* =========================================================
            DROPDOWN LINKS
            IMPORTANT:
            No sidebar-sublink class is required
            ========================================================= */

                .superadmin-sidebar .sidebar-submenu a {
                    display: block;
                    width: 100%;
                    color: #16816d;
                    text-decoration: none;
                    font-size: 18px;
                    font-weight: 400;
                    line-height: 1.5;
                    padding: 6px 0;
                    margin: 0;
                }


                    /* =========================================================
            VISITED LINK
            Prevent purple/blue browser link
            ========================================================= */

                    .superadmin-sidebar .sidebar-submenu a:visited {
                        color: #16816d;
                        text-decoration: none;
                    }


                    /* =========================================================
            HOVER
            ========================================================= */

                    .superadmin-sidebar .sidebar-submenu a:hover {
                        color: #16816d;
                        text-decoration: none;
                    }


                    /* =========================================================
            ACTIVE SUBMENU
            ========================================================= */

                    .superadmin-sidebar .sidebar-submenu a.active {
                        color: #16816d;
                        font-weight: 500;
                    }


            /* =========================================================
            DROPDOWN SPACING
            ========================================================= */

            .superadmin-sidebar .sidebar-menu {
                width: 105%;
                margin-bottom: 4px;
            }


            /* =========================================================
            DROPDOWN HEADER
            ========================================================= */

            .superadmin-sidebar .sidebar-dropdown {
                min-height: 55px;
                padding: 10px 15px;
                border-radius: 0;
            }


                /* =========================================================
            HOVER MAIN MENU
            ========================================================= */

                .superadmin-sidebar .sidebar-dropdown:hover {
                    color: #16816d;
                }

                l
            /* =========================================================
            ACTIVE DASHBOARD
            ========================================================= */

            .superadmin-sidebar .sidebar-link.active {
                color: #16816d;
            }

                .superadmin-sidebar .sidebar-link.active .menu-icon,
                .superadmin-sidebar .sidebar-link.active .menu-text {
                    color: #16816d;
                }
    </style>

