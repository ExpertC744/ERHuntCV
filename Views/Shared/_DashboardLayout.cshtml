            SUPER ADMIN SIDEBAR
            ========================================================= */

        .superadmin-sidebar {
            width: 100%;
        }


            /* =========================================================
            MAIN SIDEBAR MENU
            ========================================================= */

            .superadmin-sidebar .sidebar-link {
                display: flex;
