	<style>

		.feedback-edit-container {
			width: 100%;
			display: flex;
			justify-content: center;
			padding: 0;
			margin: 0;
			box-sizing: border-box;
		}

		.feedback-edit-card {
			width: 870px;
			max-width: 100%;
			background: #f4faf8;
			border: 1px solid #d7e8e3;
			border-top: 4px solid #0f5d52;
			border-radius: 0 0 20px 20px;
			padding: 38px 35px 42px 35px;
			box-sizing: border-box;
			box-shadow: 0 5px 18px rgba(15, 93, 82, 0.10);
		}

		.feedback-edit-title {
			margin: 0 0 24px 0;
			font-family: Arial, Helvetica, sans-serif;
			font-size: 30px;
			font-weight: 600;
			color: #0f5d52;
		}

		.feedback-question {
			margin-bottom: 18px;
		}

		.question-label {
			display: block;
			margin-bottom: 10px;
			font-family: Arial, Helvetica, sans-serif;
			font-size: 17px;
			font-weight: 600;
			color: #0f5d52;
		}

		.question-textarea {
			display: block;
			width: 100%;
			min-height: 58px;
			padding: 7px 12px;
			border: 1px solid #b9d6cd;
			border-radius: 6px;
			background: #fff;
			color: #1f2d2b;
			font-family: Arial, Helvetica, sans-serif;
			font-size: 16px;
			line-height: 1.45;
			resize: vertical;
			box-sizing: border-box;
			outline: none;
			transition: border-color 0.15s ease, box-shadow 0.15s ease;
		}

			.question-textarea:focus {
				border-color: #17a589;
				box-shadow: 0 0 0 3px rgba(23, 165, 137, 0.15);
			}

		.answer-area {
			margin-left: 23px;
			margin-top: 10px;
			margin-bottom: 13px;
		}

		.radio-options {
			display: flex;
			align-items: center;
			gap: 5px;
			font-family: Arial, Helvetica, sans-serif;
			font-size: 17px;
			color: #1f2d2b;
		}

			.radio-options label {
				display: flex;
				align-items: center;
				gap: 5px;
				margin-right: 4px;
				cursor: pointer;
			}

			.radio-options input[type="radio"] {
				width: 14px;
				height: 14px;
				margin: 0;
				cursor: pointer;
				accent-color: #0f5d52;
			}

		.star-options {
			display: flex;
			align-items: center;
			gap: 3px;
		}

			.star-options label {
				position: relative;
				width: 35px;
				height: 35px;
				display: flex;
				align-items: center;
				justify-content: center;
				cursor: pointer;
			}

			.star-options input[type="radio"] {
				position: absolute;
				opacity: 0;
				pointer-events: none;
			}

		.star {
			display: inline-block;
			font-size: 30px;
			line-height: 1;
			color: #c7d9d4;
			transition: all 0.15s ease;
			cursor: pointer;
		}

			.star.active {
				color: #17a589;
			}

		.star-options label:hover .star {
			color: #17a589;
			transform: scale(1.15);
		}

		.emoji-options {
			display: flex;
			align-items: center;
			gap: 12px;
		}

			.emoji-options label {
				position: relative;
				width: 43px;
				height: 43px;
				display: flex;
				align-items: center;
				justify-content: center;
				border-radius: 50%;
				cursor: pointer;
				transition: all 0.2s ease;
			}

			.emoji-options input[type="radio"] {
				position: absolute;
				opacity: 0;
				pointer-events: none;
			}

		.emoji {
			display: inline-block;
			font-family: "Segoe UI Emoji", "Apple Color Emoji", "Noto Color Emoji", sans-serif;
			font-size: 27px;
			filter: grayscale(100%);
			opacity: 0.55;
			transition: all 0.2s ease;
			cursor: pointer;
		}

		.emoji-options label:hover {
			background: #e7f3ef;
			transform: translateY(-2px);
			box-shadow: 0 2px 7px rgba(15, 93, 82, 0.12);
		}

			.emoji-options label:hover .emoji {
				filter: grayscale(0%);
				opacity: 1;
				transform: scale(1.15);
			}

		.emoji-options label.selected {
			background: #e7f3ef;
			box-shadow: 0 2px 8px rgba(15, 93, 82, 0.20);
			transform: translateY(-2px);
		}

			.emoji-options label.selected .emoji {
				filter: grayscale(0%);
				opacity: 1;
				transform: scale(1.2);
			}

		.description-label {
			display: block;
			margin-left: 0;
			margin-top: 3px;
			margin-bottom: 7px;
			font-family: Arial, Helvetica, sans-serif;
			font-size: 17px;
			color: #0f5d52;
			font-weight: 600;
		}

		.description-textarea {
			display: block;
			width: 100%;
			min-height: 72px;
			margin-left: 0;
			padding: 8px 12px;
			border: 1px solid #b9d6cd;
			border-radius: 6px;
			background: #fff;
			color: #1f2d2b;
			font-family: Arial, Helvetica, sans-serif;
			font-size: 16px;
			line-height: 1.4;
			resize: vertical;
			box-sizing: border-box;
			outline: none;
			transition: border-color 0.15s ease, box-shadow 0.15s ease;
		}

			.description-textarea:focus {
				border-color: #17a589;
				box-shadow: 0 0 0 3px rgba(23, 165, 137, 0.15);
			}

		.save-area {
			margin-left: 23px;
			margin-top: 20px;
		}

		.save-button {
			background: #0f5d52;
			color: #fff;
			border: 1px solid #0f5d52;
			border-radius: 6px;
			padding: 7px 15px;
			font-family: Arial, Helvetica, sans-serif;
			font-size: 14px;
			font-weight: 600;
			cursor: pointer;
			transition: all 0.15s ease;
		}

			.save-button:hover {
				background: #0c4b42;
				border-color: #0c4b42;
			}

		.validation-message {
			display: block;
			margin-left: 23px;
			margin-top: 3px;
			color: #dc3545;
			font-size: 12px;
		}

		@@media (max-width: 900px) {

			.feedback-edit-card {
				width: 100%;
				padding: 30px 25px 35px 25px;
			}

			.feedback-edit-title {
				font-size: 28px;
			}

			.question-textarea {
				font-size: 15px;
			}

			.answer-area,
			.save-area {
				margin-left: 15px;
			}

			.star {
				font-size: 27px;
			}

			.emoji {
				font-size: 24px;
			}
		}

		@@media (max-width: 500px) {

			.feedback-edit-card {
				padding: 25px 18px 30px 18px;
			}

			.feedback-edit-title {
				font-size: 24px;
			}

			.question-label {
				font-size: 16px;
			}

			.answer-area,
			.save-area {
				margin-left: 10px;
			}

			.star-options {
				gap: 1px;
			}

				.star-options label {
					width: 32px;
				}

			.star {
				font-size: 24px;
			}

			.emoji-options {
				gap: 7px;
			}

				.emoji-options label {
					width: 39px;
					height: 39px;
				}

			.emoji {
				font-size: 21px;
			}
		}

		/* =========================================================
														   JOB PORTAL DASHBOARD
														   PROFESSIONAL CANDIDATE DASHBOARD
														   Theme: #1e7b67 + #ffffff
														========================================================= */

		:root {
			--primary: #1e7b67;
			--primary-dark: #155d4e;
			--primary-light: #e8f5f1;
			--primary-soft: #f3faf7;
			--white: #ffffff;
			--text-dark: #1d2939;
			--text: #344054;
			--text-muted: #667085;
			--text-light: #98a2b3;
			--border: #e9edf2;
			--background: #f7f9fc;
			--danger: #d64545;
			--danger-light: #fff2f2;
			--sidebar-width: 255px;
			--sidebar-collapsed-width: 78px;
			--header-height: 78px;
			--shadow-sm: 0 4px 15px rgba(15, 23, 42, .05);
			--shadow-md: 0 12px 30px rgba(15, 23, 42, .08);
			--transition: all .3s ease;
		}


		/* =========================================================
														   GLOBAL
														========================================================= */

		* {
			box-sizing: border-box;
		}

		html {
			margin: 0;
			padding: 0;
			scroll-behavior: smooth;
		}

		body {
			margin: 0;
			padding: 0;
			font-family: "Inter", "Segoe UI", Arial, sans-serif;
			background: var(--background);
			color: var(--text);
			overflow-x: hidden;
		}

		a {
			text-decoration: none;
		}

		button,
		input {
			font-family: inherit;
		}

		button {
			outline: none;
		}

			button:focus {
				outline: none;
			}


		/* =========================================================
														   DASHBOARD WRAPPER
														========================================================= */

		.dashboard-wrapper {
			display: flex;
			width: 100%;
			min-height: 100vh;
		}


		/* =========================================================
														   SIDEBAR
														========================================================= */

		.dashboard-sidebar {
			position: fixed;
			top: 0;
			left: 0;
			width: var(--sidebar-width);
			height: 100vh;
			display: flex;
			flex-direction: column;
			background: var(--white);
			border-right: 1px solid var(--border);
			z-index: 1000;
			overflow: hidden;
			transition: width .3s ease, transform .3s ease;
			box-shadow: 4px 0 22px rgba(30, 123, 103, .035);
		}


		/* =========================================================
														   SIDEBAR LOGO
														========================================================= */

		.sidebar-logo {
			width: 100%;
			height: var(--header-height);
			min-height: var(--header-height);
			display: flex;
			align-items: center;
			padding: 0 24px;
			background: var(--white);
			border-bottom: 1px solid var(--border);
			transition: var(--transition);
		}


		/* Logo icon */

		.logo-icon {
			width: 40px;
			height: 40px;
			min-width: 40px;
			display: flex;
			align-items: center;
			justify-content: center;
			border-radius: 12px;
			background: linear-gradient( 135deg, #1e7b67, #43a88e );
			color: #ffffff;
			font-size: 17px;
			box-shadow: 0 7px 16px rgba(30, 123, 103, .20);
			transition: var(--transition);
		}


		/* Logo text */

		.logo-text {
			margin-left: 12px;
			white-space: nowrap;
			font-size: 21px;
			font-weight: 800;
			letter-spacing: -.5px;
			color: #172b25;
			transition: opacity .2s ease, visibility .2s ease, width .3s ease, margin .3s ease;
		}

			.logo-text span {
				color: var(--primary);
			}


		/* =========================================================
														   SIDEBAR SECTION
														========================================================= */

		.sidebar-section {
			flex: 1;
			padding: 22px 14px 10px;
			overflow-y: auto;
			overflow-x: hidden;
		}


			/* Scrollbar */

			.sidebar-section::-webkit-scrollbar {
				width: 4px;
			}

			.sidebar-section::-webkit-scrollbar-track {
				background: transparent;
			}

			.sidebar-section::-webkit-scrollbar-thumb {
				background: #dce8e4;
				border-radius: 10px;
			}

				.sidebar-section::-webkit-scrollbar-thumb:hover {
					background: #b8d7ce;
				}


		/* =========================================================
														   SIDEBAR TITLE
														========================================================= */

		.sidebar-title {
			height: 20px;
			padding: 0 12px 10px;
			color: #a0a9b5;
			font-size: 10px;
			font-weight: 800;
			text-transform: uppercase;
			letter-spacing: 1.2px;
			white-space: nowrap;
			overflow: hidden;
			transition: opacity .2s ease, height .3s ease, padding .3s ease;
		}


		/* =========================================================
														   SIDEBAR LINKS
														========================================================= */

		.sidebar-link {
			position: relative;
			width: 100%;
			height: 48px;
			display: flex;
			align-items: center;
			padding: 0 12px;
			margin-bottom: 5px;
			border-radius: 11px;
			color: var(--text-muted);
			font-size: 13px;
			font-weight: 600;
			white-space: nowrap;
			transition: background .25s ease, color .25s ease, transform .25s ease, box-shadow .25s ease;
		}


			/* Hover */

			.sidebar-link:hover {
				color: var(--primary);
				background: var(--primary-soft);
				transform: translateX(2px);
			}


			/* Active */

			.sidebar-link.active {
				color: var(--primary);
				background: var(--primary-light);
				font-weight: 700;
				box-shadow: inset 0 0 0 1px rgba(30, 123, 103, .04);
			}


				/* Active indicator */

				.sidebar-link.active::before {
					content: "";
					position: absolute;
					left: 0;
					top: 10px;
					width: 3px;
					height: 28px;
					border-radius: 0 5px 5px 0;
					background: var(--primary);
				}


		/* =========================================================
														   MENU ICON
														========================================================= */

		.menu-icon {
			width: 35px;
			min-width: 35px;
			height: 35px;
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 15px;
			transition: var(--transition);
		}

		.sidebar-link.active .menu-icon {
			color: var(--primary);
		}


		/* =========================================================
														   MENU TEXT
														========================================================= */

		.menu-text {
			flex: 1;
			min-width: 0;
			margin-left: 0;
			overflow: hidden;
			text-overflow: ellipsis;
			transition: opacity .2s ease, width .3s ease, margin .3s ease;
		}


		/* =========================================================
														   MENU BADGE
														========================================================= */

		.menu-badge {
			min-width: 25px;
			height: 21px;
			padding: 0 6px;
			display: flex;
			align-items: center;
			justify-content: center;
			border-radius: 20px;
			background: var(--primary-light);
			color: var(--primary);
			font-size: 10px;
			font-weight: 700;
		}


		/* =========================================================
														   SIDEBAR BOTTOM
														========================================================= */

		.sidebar-bottom {
			width: 100%;
			padding: 15px;
			background: var(--white);
			border-top: 1px solid var(--border);
		}


		/* =========================================================
														   SIDEBAR USER
														========================================================= */

		.sidebar-user {
			display: flex;
			align-items: center;
			width: 100%;
			padding: 11px;
			margin-bottom: 8px;
			border-radius: 12px;
			background: #f8fafb;
			transition: var(--transition);
		}

			.sidebar-user:hover {
				background: var(--primary-soft);
			}


		/* Avatar */

		.sidebar-user-avatar {
			width: 38px;
			height: 38px;
			min-width: 38px;
			display: flex;
			align-items: center;
			justify-content: center;
			border-radius: 11px;
			background: var(--primary-light);
			color: var(--primary);
			font-size: 14px;
		}


		/* User info */

		.sidebar-user-info {
			min-width: 0;
			margin-left: 10px;
			overflow: hidden;
			transition: opacity .2s ease, width .3s ease, margin .3s ease;
		}

			.sidebar-user-info strong {
				display: block;
				color: var(--text-dark);
				font-size: 12px;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}

			.sidebar-user-info small {
				display: block;
				margin-top: 2px;
				color: var(--text-light);
				font-size: 10px;
				text-transform: capitalize;
			}


		/* =========================================================
														   SIDEBAR LOGOUT
														========================================================= */

		.logout-link {
			position: relative;
			width: 100%;
			height: 45px;
			display: flex;
			align-items: center;
			padding: 0 12px;
			border-radius: 10px;
			color: #8b96a5;
			font-size: 13px;
			font-weight: 600;
			white-space: nowrap;
			transition: var(--transition);
		}

			.logout-link:hover {
				color: var(--danger);
				background: var(--danger-light);
			}


		/* =========================================================
														   COLLAPSED SIDEBAR
														========================================================= */

		.dashboard-sidebar.sidebar-collapsed {
			width: var(--sidebar-collapsed-width);
		}


			/* Logo */

			.dashboard-sidebar.sidebar-collapsed .sidebar-logo {
				justify-content: center;
				padding: 0;
			}

			.dashboard-sidebar.sidebar-collapsed .logo-text {
				width: 0;
				margin: 0;
				opacity: 0;
				visibility: hidden;
			}


			/* Section */

			.dashboard-sidebar.sidebar-collapsed .sidebar-section {
				padding-left: 10px;
				padding-right: 10px;
			}


			/* Section title */

			.dashboard-sidebar.sidebar-collapsed .sidebar-title {
				height: 0;
				padding: 0;
				opacity: 0;
				visibility: hidden;
			}


			/* Links */

			.dashboard-sidebar.sidebar-collapsed .sidebar-link {
				justify-content: center;
				padding: 0;
				border-radius: 12px;
				transform: none;
			}

				.dashboard-sidebar.sidebar-collapsed .sidebar-link:hover {
					transform: none;
				}


				/* Active */

				.dashboard-sidebar.sidebar-collapsed
				.sidebar-link.active::before {
					display: none;
				}


			/* Icons */

			.dashboard-sidebar.sidebar-collapsed .menu-icon {
				width: 42px;
				min-width: 42px;
				height: 42px;
				font-size: 16px;
			}


			/* Text */

			.dashboard-sidebar.sidebar-collapsed .menu-text {
				width: 0;
				margin: 0;
				opacity: 0;
				visibility: hidden;
			}


			/* Badge */

			.dashboard-sidebar.sidebar-collapsed .menu-badge {
				display: none;
			}


			/* Bottom */

			.dashboard-sidebar.sidebar-collapsed .sidebar-bottom {
				padding: 12px 10px;
			}


			/* User */

			.dashboard-sidebar.sidebar-collapsed .sidebar-user {
				justify-content: center;
				padding: 7px;
				background: transparent;
			}

			.dashboard-sidebar.sidebar-collapsed .sidebar-user-info {
				width: 0;
				margin: 0;
				opacity: 0;
				visibility: hidden;
			}


			/* Logout */

			.dashboard-sidebar.sidebar-collapsed .logout-link {
				justify-content: center;
				padding: 0;
			}

				.dashboard-sidebar.sidebar-collapsed
				.logout-link .menu-icon {
					width: 42px;
					min-width: 42px;
				}


			/* =========================================================
														   COLLAPSED SIDEBAR TOOLTIP
														========================================================= */

			.dashboard-sidebar.sidebar-collapsed
			.sidebar-link[data-title]::after {
				content: attr(data-title);
				position: absolute;
				left: calc(100% + 10px);
				top: 50%;
				padding: 8px 12px;
				border-radius: 8px;
				background: #1d2939;
				color: #ffffff;
				font-size: 11px;
				font-weight: 600;
				white-space: nowrap;
				pointer-events: none;
				opacity: 0;
				visibility: hidden;
				transform: translateY(-50%) translateX(-5px);
				z-index: 3000;
				box-shadow: 0 7px 18px rgba(0, 0, 0, .12);
				transition: opacity .2s ease, transform .2s ease;
			}

			.dashboard-sidebar.sidebar-collapsed
			.sidebar-link[data-title]:hover::after {
				opacity: 1;
				visibility: visible;
				transform: translateY(-50%) translateX(0);
			}


		/* =========================================================
														   MAIN CONTENT AREA
														========================================================= */

		.dashboard-main {
			width: calc(100% - var(--sidebar-width));
			min-height: 100vh;
			margin-left: var(--sidebar-width);
			transition: width .3s ease, margin-left .3s ease;
		}


			/* Main after collapse */

			.dashboard-main.sidebar-collapsed {
				width: calc(100% - var(--sidebar-collapsed-width));
				margin-left: var(--sidebar-collapsed-width);
			}


		/* =========================================================
														   HEADER / NAVBAR
														========================================================= */

		.dashboard-header {
			position: sticky;
			top: 0;
			z-index: 900;
			width: 100%;
			height: var(--header-height);
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 0 28px;
			background: rgba(255, 255, 255, .96);
			backdrop-filter: blur(12px);
			-webkit-backdrop-filter: blur(12px);
			border-bottom: 1px solid var(--border);
			box-shadow: 0 3px 15px rgba(31, 45, 61, .025);
		}


		/* =========================================================
														   HEADER LEFT
														========================================================= */

		.header-left {
			display: flex;
			align-items: center;
			gap: 15px;
		}


		/* =========================================================
														   SIDEBAR TOGGLE BUTTON
														========================================================= */

		.sidebar-toggle {
			width: 40px;
			height: 40px;
			min-width: 40px;
			display: flex;
			align-items: center;
			justify-content: center;
			padding: 0;
			border: 1px solid var(--border);
			border-radius: 10px;
			background: var(--white);
			color: var(--text-muted);
			cursor: pointer;
			font-size: 14px;
			transition: var(--transition);
		}

			.sidebar-toggle:hover {
				color: var(--primary);
				background: var(--primary-light);
				border-color: #d5ebe5;
				transform: translateY(-1px);
				box-shadow: 0 4px 12px rgba(30, 123, 103, .08);
			}

			.sidebar-toggle:active {
				transform: scale(.96);
			}


		/* =========================================================
														   HEADER PAGE INFO
														========================================================= */

		.header-page-info span {
			display: block;
		}

		.header-small-text {
			color: var(--text-light);
			font-size: 10px;
			text-transform: uppercase;
			letter-spacing: .8px;
			font-weight: 700;
		}

		.header-page-info strong {
			display: block;
			margin-top: 1px;
			color: var(--text-dark);
			font-size: 16px;
			font-weight: 700;
		}


		/* =========================================================
														   HEADER RIGHT
														========================================================= */

		.header-right {
			display: flex;
			align-items: center;
			gap: 12px;
		}


		/* =========================================================
														   SEARCH
														========================================================= */

		.header-search {
			width: 220px;
			height: 40px;
			display: flex;
			align-items: center;
			gap: 9px;
			padding: 0 13px;
			background: #f7f9fb;
			border: 1px solid #edf0f3;
			border-radius: 10px;
			transition: var(--transition);
		}

			.header-search:focus-within {
				background: var(--white);
				border-color: #cde4dd;
				box-shadow: 0 0 0 3px rgba(30, 123, 103, .07);
			}

			.header-search i {
				color: #a3acb8;
				font-size: 13px;
			}

			.header-search input {
				width: 100%;
				border: none;
				outline: none;
				background: transparent;
				color: var(--text);
				font-size: 12px;
			}

				.header-search input::placeholder {
					color: #a3acb8;
				}


		/* =========================================================
														   NOTIFICATION BUTTON
														========================================================= */

		.header-icon-btn {
			position: relative;
			width: 40px;
			height: 40px;
			min-width: 40px;
			display: flex;
			align-items: center;
			justify-content: center;
			padding: 0;
			border: 1px solid var(--border);
			border-radius: 10px;
			background: var(--white);
			color: var(--text-muted);
			cursor: pointer;
			transition: var(--transition);
		}

			.header-icon-btn:hover {
				background: var(--primary-light);
				color: var(--primary);
				border-color: #d6ebe5;
				transform: translateY(-1px);
			}


		/* Notification dot */

		.notification-dot {
			position: absolute;
			top: 7px;
			right: 7px;
			width: 8px;
			height: 8px;
			border-radius: 50%;
			background: #e85d5d;
			border: 2px solid var(--white);
		}


		/* =========================================================
														   USER DROPDOWN WRAPPER
														========================================================= */

		.header-user-dropdown {
			position: relative;
		}


		/* =========================================================
														   USER BUTTON
														========================================================= */

		.header-user {
			display: flex;
			align-items: center;
			gap: 9px;
			padding: 5px 8px 5px 5px;
			border: none;
			border-radius: 12px;
			background: transparent;
			color: var(--text);
			cursor: pointer;
			transition: background .25s ease, box-shadow .25s ease;
		}

			.header-user:hover {
				background: var(--primary-soft);
			}

			.header-user:focus {
				outline: none;
				box-shadow: 0 0 0 3px rgba(30, 123, 103, .08);
			}


		/* =========================================================
														   HEADER AVATAR
														========================================================= */

		.header-avatar {
			width: 38px;
			height: 38px;
			min-width: 38px;
			display: flex;
			align-items: center;
			justify-content: center;
			border-radius: 11px;
			background: var(--primary-light);
			color: var(--primary);
			font-size: 13px;
			transition: var(--transition);
		}

		.header-user:hover .header-avatar {
			background: #dcefe9;
		}


		/* =========================================================
														   USER INFO
														========================================================= */

		.header-user-info {
			text-align: left;
			min-width: 70px;
		}

			.header-user-info strong {
				display: block;
				color: var(--text-dark);
				font-size: 12px;
				font-weight: 700;
				white-space: nowrap;
				max-width: 120px;
				overflow: hidden;
				text-overflow: ellipsis;
			}

			.header-user-info small {
				display: block;
				margin-top: 1px;
				color: var(--text-light);
				font-size: 10px;
				text-transform: capitalize;
			}


		/* =========================================================
														   USER ARROW
														========================================================= */

		.user-arrow {
			margin-left: 4px;
			color: #98a2b3;
			font-size: 9px;
			transition: transform .25s ease, color .25s ease;
		}


		/* Arrow rotate when dropdown open */

		.header-user-dropdown.open .user-arrow {
			color: var(--primary);
			transform: rotate(180deg);
		}


		/* =========================================================
														   USER DROPDOWN MENU
														========================================================= */

		.user-dropdown-menu {
			position: absolute;
			top: calc(100% + 10px);
			right: 0;
			width: 245px;
			padding: 8px;
			background: var(--white);
			border: 1px solid var(--border);
			border-radius: 15px;
			box-shadow: 0 18px 45px rgba(15, 23, 42, .12);
			opacity: 0;
			visibility: hidden;
			pointer-events: none;
			transform: translateY(-8px) scale(.97);
			transform-origin: top right;
			z-index: 5000;
			transition: opacity .2s ease, visibility .2s ease, transform .2s ease;
		}


		/* Open */

		.header-user-dropdown.open .user-dropdown-menu {
			opacity: 1;
			visibility: visible;
			pointer-events: auto;
			transform: translateY(0) scale(1);
		}


		/* =========================================================
														   DROPDOWN USER HEADER
														========================================================= */

		.dropdown-user-header {
			display: flex;
			align-items: center;
			gap: 11px;
			padding: 10px 9px 11px;
		}


		/* Dropdown avatar */

		.dropdown-avatar {
			width: 42px;
			height: 42px;
			min-width: 42px;
			display: flex;
			align-items: center;
			justify-content: center;
			border-radius: 12px;
			background: var(--primary-light);
			color: var(--primary);
			font-size: 14px;
		}


		/* Dropdown name */

		.dropdown-user-header strong {
			display: block;
			color: var(--text-dark);
			font-size: 13px;
			font-weight: 700;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
			max-width: 160px;
		}

		.dropdown-user-header small {
			display: block;
			margin-top: 3px;
			color: var(--text-light);
			font-size: 10px;
			text-transform: capitalize;
		}


		/* =========================================================
														   DROPDOWN DIVIDER
														========================================================= */

		.dropdown-divider {
			width: calc(100% - 8px);
			height: 1px;
			margin: 5px 4px;
			background: var(--border);
		}


		/* =========================================================
														   DROPDOWN ITEM
														========================================================= */

		.user-dropdown-item {
			width: 100%;
			min-height: 45px;
			display: flex;
			align-items: center;
			gap: 11px;
			padding: 7px 9px;
			border-radius: 10px;
			color: var(--text);
			font-size: 12px;
			font-weight: 600;
			transition: background .2s ease, color .2s ease, transform .2s ease;
		}

			.user-dropdown-item:hover {
				color: var(--primary);
				background: var(--primary-light);
				transform: translateX(2px);
			}


		/* =========================================================
														   DROPDOWN ICON
														========================================================= */

		.dropdown-item-icon {
			width: 32px;
			height: 32px;
			min-width: 32px;
			display: flex;
			align-items: center;
			justify-content: center;
			border-radius: 8px;
			background: #f5f7f9;
			color: #667085;
			font-size: 12px;
			transition: var(--transition);
		}

		.user-dropdown-item:hover .dropdown-item-icon {
			background: var(--white);
			color: var(--primary);
			box-shadow: 0 3px 8px rgba(30, 123, 103, .08);
		}


		/* =========================================================
														   LOGOUT DROPDOWN
														========================================================= */

		.logout-dropdown {
			color: var(--danger);
		}

			.logout-dropdown .dropdown-item-icon {
				color: var(--danger);
				background: var(--danger-light);
			}

			.logout-dropdown:hover {
				color: #c73737;
				background: var(--danger-light);
			}

				.logout-dropdown:hover .dropdown-item-icon {
					color: #c73737;
					background: var(--white);
				}


		/* =========================================================
														   DASHBOARD CONTENT
														========================================================= */

		.dashboard-content {
			width: 100%;
			padding: 28px;
		}


		/* =========================================================
														   MOBILE SIDEBAR OVERLAY
														========================================================= */

		.sidebar-overlay {
			display: none;
			position: fixed;
			inset: 0;
			background: rgba(15, 23, 42, .38);
			backdrop-filter: blur(2px);
			-webkit-backdrop-filter: blur(2px);
			z-index: 999;
			opacity: 0;
			transition: opacity .3s ease;
		}

			.sidebar-overlay.show {
				display: block;
				opacity: 1;
			}


		/* =========================================================
														   TABLET
														========================================================= */

		@@media (max-width: 1100px) {
			.header-search {
				width: 180px;
			}

			.dashboard-content {
				padding: 24px;
			}
		}


		/* =========================================================
														   MOBILE / TABLET
														========================================================= */

		@@media (max-width: 991px) {
			/* Sidebar drawer */

			.dashboard-sidebar {
				width: var(--sidebar-width);
				transform: translateX(-100%);
				box-shadow: 8px 0 30px rgba(15, 23, 42, .12);
			}
				/* Open sidebar */

				.dashboard-sidebar.sidebar-collapsed {
					width: var(--sidebar-width);
					transform: translateX(0);
				}
					/* Restore logo */

					.dashboard-sidebar.sidebar-collapsed .sidebar-logo {
						justify-content: flex-start;
						padding: 0 24px;
					}

					.dashboard-sidebar.sidebar-collapsed .logo-text {
						width: auto;
						margin-left: 12px;
						opacity: 1;
						visibility: visible;
					}
					/* Restore section title */

					.dashboard-sidebar.sidebar-collapsed .sidebar-title {
						height: 20px;
						padding: 0 12px 10px;
						opacity: 1;
						visibility: visible;
					}
					/* Restore links */

					.dashboard-sidebar.sidebar-collapsed .sidebar-link {
						justify-content: flex-start;
						padding: 0 12px;
					}

						.dashboard-sidebar.sidebar-collapsed
						.sidebar-link.active::before {
							display: block;
						}
					/* Restore icon */

					.dashboard-sidebar.sidebar-collapsed .menu-icon {
						width: 35px;
						min-width: 35px;
						height: 35px;
					}
					/* Restore text */

					.dashboard-sidebar.sidebar-collapsed .menu-text {
						width: auto;
						margin-left: 0;
						opacity: 1;
						visibility: visible;
					}
					/* Restore badge */

					.dashboard-sidebar.sidebar-collapsed .menu-badge {
						display: flex;
					}
					/* Restore user */

					.dashboard-sidebar.sidebar-collapsed .sidebar-user {
						justify-content: flex-start;
						padding: 11px;
						background: #f8fafb;
					}

					.dashboard-sidebar.sidebar-collapsed .sidebar-user-info {
						width: auto;
						margin-left: 10px;
						opacity: 1;
						visibility: visible;
					}
					/* Restore logout */

					.dashboard-sidebar.sidebar-collapsed .logout-link {
						justify-content: flex-start;
						padding: 0 12px;
					}
			/* Main */

			.dashboard-main,
			.dashboard-main.sidebar-collapsed {
				width: 100%;
				margin-left: 0;
			}
			/* Header */

			.dashboard-header {
				padding: 0 22px;
			}
			/* Search hidden */

			.header-search {
				display: none;
			}
			/* Content */

			.dashboard-content {
				padding: 22px;
			}
		}


		/* =========================================================
														   MOBILE
														========================================================= */

		@@media (max-width: 576px) {
			: root {
				--header-height: 68px;
			}


			.dashboard-header {
				height: 68px;
				padding: 0 16px;
			}
			/* Hide page title */

			.header-page-info {
				display: none;
			}


			.header-right {
				gap: 7px;
			}
			/* Hide user text */

			.header-user-info {
				display: none;
			}


			.user-arrow {
				margin-left: 1px;
			}
			/* Avatar */

			.header-avatar {
				width: 38px;
				height: 38px;
			}
			/* User dropdown */

			.user-dropdown-menu {
				right: -5px;
				width: 225px;
			}
			/* Content */

			.dashboard-content {
				padding: 16px;
			}
			/* Toggle */

			.sidebar-toggle {
				width: 38px;
				height: 38px;
			}
			/* Notification */

			.header-icon-btn {
				width: 38px;
				height: 38px;
			}
		}


		/* =========================================================
														   SMALL MOBILE
														========================================================= */

		@@media (max-width: 380px) {
			.dashboard-content {
				padding: 12px;
			}


			.dashboard-header {
				padding: 0 12px;
			}


			.header-right {
				gap: 5px;
			}


			.header-icon-btn,
			.sidebar-toggle {
				width: 36px;
				height: 36px;
				min-width: 36px;
			}


			.header-avatar {
				width: 36px;
				height: 36px;
				min-width: 36px;
			}


			.user-dropdown-menu {
				width: 210px;
				right: -8px;
			}
		}


		/* =========================================================
														   REDUCED MOTION
														========================================================= */

		@@media (prefers-reduced-motion: reduce) {
			*, *::before, *::after {
				scroll-behavior: auto !important;
				transition-duration: .01ms !important;
				animation-duration: .01ms !important;
				animation-iteration-count: 1 !important;
			}
		}

		/* =========================================================
											   ORGANIZATION SIDEBAR - GREEN SCREENSHOT STYLE
											   ========================================================= */

		/* ---------------------------------------------------------
											   SIDEBAR SECTION
											   --------------------------------------------------------- */

		.sidebar-section {
			padding: 18px 14px 20px;
		}

			/* Hide Organization title */
			.sidebar-section .sidebar-title {
				display: none;
			}


			/* ---------------------------------------------------------
											   MAIN MENU ITEM
											   --------------------------------------------------------- */

			.sidebar-section .sidebar-link {
				position: relative;
				width: 100%;
				height: 58px;
				display: flex;
				align-items: center;
				padding: 0 10px;
				margin-bottom: 10px;
				border-radius: 10px;
				background: transparent;
				color: #1e7b67;
				font-size: 16px;
				font-weight: 500;
				transform: none;
				transition: background .2s ease, color .2s ease;
			}


				/* Hover */
				.sidebar-section .sidebar-link:hover {
					color: #1e7b67;
					background: #f3faf7;
					transform: none;
				}


			/* ---------------------------------------------------------
											   ICON
											   --------------------------------------------------------- */

			.sidebar-section .menu-icon {
				width: 35px;
				min-width: 35px;
				height: 35px;
				display: flex;
				align-items: center;
				justify-content: center;
				color: #1e7b67;
				font-size: 17px;
				transition: color .2s ease;
			}


			/* ---------------------------------------------------------
											   TEXT
											   --------------------------------------------------------- */

			.sidebar-section .menu-text {
				margin-left: 0;
				color: #1e7b67;
				font-size: 16px;
				font-weight: 500;
				overflow: visible;
			}


		/* ---------------------------------------------------------
											   ARROW
											   --------------------------------------------------------- */

		.profile-arrow {
			width: 30px;
			min-width: 30px;
			margin-left: auto;
			display: flex;
			align-items: center;
			justify-content: center;
			color: #1e7b67;
			font-size: 13px;
			transition: transform .25s ease, color .2s ease;
		}


			/* Open arrow */
			.profile-arrow.open {
				transform: rotate(90deg);
			}


		/* ---------------------------------------------------------
											   DROPDOWN CONTAINER
											   --------------------------------------------------------- */

		.sidebar-dropdown {
			width: 100%;
		}


		/* ---------------------------------------------------------
											   SUB MENU
											   --------------------------------------------------------- */

		.profile-submenu {
			display: none;
			width: 100%;
			padding-left: 45px;
			margin-top: -3px;
			margin-bottom: 8px;
		}


			/* Open submenu */
			.profile-submenu.show {
				display: block;
			}


		/* ---------------------------------------------------------
											   SUB MENU LINKS
											   --------------------------------------------------------- */

		.profile-submenu-link {
			display: block;
			padding: 9px 0;
			color: #1e7b67;
			font-size: 15px;
			font-weight: 400;
			text-decoration: none;
			transition: color .2s ease, padding-left .2s ease;
		}


			.profile-submenu-link:hover {
				color: #155d4e;
				padding-left: 4px;
				text-decoration: none;
			}


		/* ---------------------------------------------------------
											   ACTIVE ITEM
											   --------------------------------------------------------- */

		.sidebar-section .sidebar-link.active {
			background: #e8f5f1;
			color: #1e7b67;
			box-shadow: none;
			font-weight: 600;
		}


			/* Active icon */
			.sidebar-section .sidebar-link.active .menu-icon {
				color: #1e7b67;
			}


			/* Active text */
			.sidebar-section .sidebar-link.active .menu-text {
				color: #1e7b67;
			}


			/* Remove old active line */
			.sidebar-section .sidebar-link.active::before {
				display: none;
			}


		/* ---------------------------------------------------------
											   SUBMENU ACTIVE
											   --------------------------------------------------------- */

		.profile-submenu-link.active {
			color: #155d4e;
			font-weight: 600;
		}


		/* ---------------------------------------------------------
											   ORGANIZATION SIDEBAR COLLAPSED MODE
											   --------------------------------------------------------- */

		.dashboard-sidebar.sidebar-collapsed
		.sidebar-section .sidebar-link {
			height: 52px;
			margin-bottom: 8px;
		}


		/* Hide submenu when collapsed */
		.dashboard-sidebar.sidebar-collapsed
		.profile-submenu {
			display: none !important;
		}


		/* Hide arrows when collapsed */
		.dashboard-sidebar.sidebar-collapsed
		.profile-arrow {
			display: none;
		}


		/* ---------------------------------------------------------
											   COLLAPSED ACTIVE
											   --------------------------------------------------------- */

		.dashboard-sidebar.sidebar-collapsed
		.sidebar-section .sidebar-link.active {
			background: #e8f5f1;
		}


		/* ---------------------------------------------------------
											   COLLAPSED ICON
											   --------------------------------------------------------- */

		.dashboard-sidebar.sidebar-collapsed
		.sidebar-section .menu-icon {
			color: #1e7b67;
		}

		/* =========================================================
											   CANDIDATE SIDEBAR - SAME GREEN TEMPLATE THEME
											   ========================================================= */

		.candidate-sidebar {
			padding: 18px 14px 20px;
		}


			/* Hide Candidate title */
			.candidate-sidebar .sidebar-title {
				display: none;
			}


			/* =========================================================
											   MAIN MENU
											   ========================================================= */

			.candidate-sidebar .sidebar-link {
				position: relative;
				width: 100%;
				height: 58px;
				display: flex;
				align-items: center;
				padding: 0 10px;
				margin-bottom: 10px;
				border-radius: 10px;
				background: transparent;
				color: #1e7b67;
				font-size: 16px;
				font-weight: 500;
				transform: none;
				transition: background .2s ease, color .2s ease;
			}


				/* Hover */

				.candidate-sidebar .sidebar-link:hover {
					color: #1e7b67;
					background: #f3faf7;
					transform: none;
				}


			/* =========================================================
											   ICON
											   ========================================================= */

			.candidate-sidebar .menu-icon {
				width: 35px;
				min-width: 35px;
				height: 35px;
				display: flex;
				align-items: center;
				justify-content: center;
				color: #1e7b67;
				font-size: 17px;
			}


			/* =========================================================
											   TEXT
					========================================================= */

			.candidate-sidebar .menu-text {
				margin-left: 0;
				color: #1e7b67;
				font-size: 16px;
				font-weight: 500;
				overflow: visible;
			}


			/* =========================================================
											   ARROW
											   ========================================================= */

			.candidate-sidebar .profile-arrow {
				width: 30px;
				min-width: 30px;
				margin-left: auto;
				display: flex;
				align-items: center;
				justify-content: center;
