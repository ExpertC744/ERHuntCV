<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="utf-8" />
	<meta name="viewport"
		  content="width=device-width, initial-scale=1.0" />
	<title>
		@ViewData["Title"] - 1Trainee
	</title>

	<!-- Bootstrap -->
	<link rel="stylesheet"
		  href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

	<!-- Font Awesome -->
	<link rel="stylesheet"
		  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

