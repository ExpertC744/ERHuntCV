
@model List<SATraineeListM>

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Candidate Registration List";
    ViewData["Panel"] = "Organization";
    ViewData["UserName"] = "Organization";
}

<link rel="stylesheet" href="~/css/HuntCV-Table.css" />

<div class="container-fluid">

    <!-- Page Header -->
    <div class="hc-page-head">
        <div>
            <h2 class="hc-page-title">Candidate Registration List</h2>
            <p class="hc-page-sub">View and manage registered candidates</p>
        </div>

        <a asp-controller="Organization"
           asp-action="Dashboard"
           class="hc-btn hc-btn-primary">
            <i class="fas fa-arrow-left"></i>
        </a>
    </div>

    <!-- Candidate Registration Master Table -->
    <div class="hc-card">

        <div class="hc-card-header">
            <span class="hc-card-icon">
                <i class="fas fa-users"></i>
            </span>
            <h5>Registered Candidates</h5>
        </div>

        <div class="hc-card-body">
            <div class="hc-table-scroll">

                <table id="candidateRegistrationTable"
                       class="table hc-table hc-nowrap hc-datatable"
                       data-page-length="10"
                       data-order-col="0"
                       data-order-dir="asc"
                       data-no-sort="14">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>First Name</th>
                            <th>Last Name</th>
                            <th>Mobile</th>
                            <th>Email</th>
                            <th>Date of Birth</th>
                            <th>Gender</th>
                            <th>College Code</th>
                            <th>College Name</th>
                            <th>Branch</th>
                            <th>Passout Year</th>
                            <th>Department</th>
                            <th>Registration Date</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @* No records currently available *@
                    </tbody>

                </table>

            </div>
        </div>
    </div>

</div>

<script src="~/js/HuntCV-Table.js"></script>
 