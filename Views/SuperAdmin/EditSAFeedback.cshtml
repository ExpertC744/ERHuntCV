@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener("DOMContentLoaded", function () {


            // =====================================================
            // STAR RATING
            // =====================================================

            const starRating =
                document.getElementById("starRating");


            if (starRating) {

                const starLabels =
                    starRating.querySelectorAll("label");

                const starInputs =
                    starRating.querySelectorAll(
                        "input[type='radio']"
                    );


                function updateStars(rating) {

                    starLabels.forEach(function (label, index) {

                        const star =
                            label.querySelector(".star");

                        if (index < rating) {

                            star.classList.add("active");

                        }
                        else {

                            star.classList.remove("active");

                        }

                    });

                }


                // Load existing value

                const checkedStar =
                    starRating.querySelector(
                        "input[type='radio']:checked"
                    );


                if (checkedStar) {

                    updateStars(
                        parseInt(checkedStar.value)
                    );

                }


                // Change rating

                starInputs.forEach(function (input) {

                    input.addEventListener(
                        "change",
                        function () {

                            updateStars(
                                parseInt(this.value)
                            );

                        }
                    );

                });


                // Hover

                starLabels.forEach(function (label, index) {

                    label.addEventListener(
                        "mouseenter",
                        function () {

                            updateStars(index + 1);

                        }
                    );


                    label.addEventListener(
                        "mouseleave",
                        function () {

                            const selected =
                                starRating.querySelector(
                                    "input[type='radio']:checked"
                                );


                            if (selected) {

                                updateStars(
                                    parseInt(selected.value)
                                );

                            }
                            else {

                                updateStars(0);

                            }

                        }
                    );

                });

            }


            // =====================================================
            // EMOJI RATING
            // =====================================================

            const emojiRating =
                document.getElementById("emojiRating");


            if (emojiRating) {

                const emojiLabels =
                    emojiRating.querySelectorAll("label");

                const emojiInputs =
                    emojiRating.querySelectorAll(
                        "input[type='radio']"
                    );


                function updateEmoji() {

                    emojiLabels.forEach(function (label) {

                        const input =
                            label.querySelector(
                                "input[type='radio']"
                            );


                        if (input.checked) {

                            label.classList.add("selected");

                        }
                        else {

                            label.classList.remove("selected");

                        }

                    });

                }


                // Load existing emoji

                updateEmoji();


                // Change emoji

                emojiInputs.forEach(function (input) {

                    input.addEventListener(
                        "change",
                        function () {

                            updateEmoji();

                        }
                    );

                });

            }

        });

    </script>

}