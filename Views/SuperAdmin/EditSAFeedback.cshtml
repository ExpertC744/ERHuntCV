@model ERHuntCV.Models.SACandidateFeedbackM

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Super Admin Dashboard";

    ViewData["Panel"] = "SuperAdmin";

    ViewData["UserName"] = "Super Admin";
}
@section Styles {

    <link rel="stylesheet"
          href="~/css/EditSAFeedback.css"
          asp-append-version="true" />

}
@{

    ViewData["Title"] = "Edit Trainee Feedback";
}
<style>

    .feedback-edit-container {
        width: 100%;
        display: flex;
        justify-content: center;
        padding: 0;
        margin: 0;
        box-sizing: border-box;
    }

    .feedback-edit-card {
        width: 870px;
        max-width: 100%;
        background: #f4faf8;
        border: 1px solid #d7e8e3;
        border-top: 4px solid #0f5d52;
        border-radius: 0 0 20px 20px;
        padding: 38px 35px 42px 35px;
        box-sizing: border-box;
        box-shadow: 0 5px 18px rgba(15, 93, 82, 0.10);
    }

    .feedback-edit-title {
        margin: 0 0 24px 0;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 30px;
        font-weight: 600;
        color: #0f5d52;
    }

    .feedback-question {
        margin-bottom: 18px;
    }

    .question-label {
        display: block;
        margin-bottom: 10px;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 17px;
        font-weight: 600;
        color: #0f5d52;
    }

    .question-textarea {
        display: block;
        width: 100%;
        min-height: 58px;
        padding: 7px 12px;
        border: 1px solid #b9d6cd;
        border-radius: 6px;
        background: #fff;
        color: #1f2d2b;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 16px;
        line-height: 1.45;
        resize: vertical;
        box-sizing: border-box;
        outline: none;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

        .question-textarea:focus {
            border-color: #17a589;
            box-shadow: 0 0 0 3px rgba(23, 165, 137, 0.15);
        }

    .answer-area {
        margin-left: 23px;
        margin-top: 10px;
        margin-bottom: 13px;
    }

    .radio-options {
        display: flex;
        align-items: center;
        gap: 5px;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 17px;
        color: #1f2d2b;
    }

        .radio-options label {
            display: flex;
            align-items: center;
            gap: 5px;
            margin-right: 4px;
            cursor: pointer;
        }

        .radio-options input[type="radio"] {
            width: 14px;
            height: 14px;
            margin: 0;
            cursor: pointer;
            accent-color: #0f5d52;
        }

    .star-options {
        display: flex;
        align-items: center;
        gap: 3px;
    }

        .star-options label {
            position: relative;
            width: 35px;
            height: 35px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        .star-options input[type="radio"] {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

    .star {
        display: inline-block;
        font-size: 30px;
        line-height: 1;
        color: #c7d9d4;
        transition: all 0.15s ease;
        cursor: pointer;
    }

        .star.active {
            color: #17a589;
        }

    .star-options label:hover .star {
        color: #17a589;
        transform: scale(1.15);
    }

    .emoji-options {
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .emoji-options label {
            position: relative;
            width: 43px;
            height: 43px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .emoji-options input[type="radio"] {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

    .emoji {
        display: inline-block;
        font-family: "Segoe UI Emoji", "Apple Color Emoji", "Noto Color Emoji", sans-serif;
        font-size: 27px;
        filter: grayscale(100%);
        opacity: 0.55;
        transition: all 0.2s ease;
        cursor: pointer;
    }

    .emoji-options label:hover {
        background: #e7f3ef;
        transform: translateY(-2px);
        box-shadow: 0 2px 7px rgba(15, 93, 82, 0.12);
    }

        .emoji-options label:hover .emoji {
            filter: grayscale(0%);
            opacity: 1;
            transform: scale(1.15);
        }

    .emoji-options label.selected {
        background: #e7f3ef;
        box-shadow: 0 2px 8px rgba(15, 93, 82, 0.20);
        transform: translateY(-2px);
    }

        .emoji-options label.selected .emoji {
            filter: grayscale(0%);
            opacity: 1;
            transform: scale(1.2);
        }

    .description-label {
        display: block;
        margin-left: 0;
        margin-top: 3px;
        margin-bottom: 7px;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 17px;
        color: #0f5d52;
        font-weight: 600;
    }

    .description-textarea {
        display: block;
        width: 100%;
        min-height: 72px;
        margin-left: 0;
        padding: 8px 12px;
        border: 1px solid #b9d6cd;
        border-radius: 6px;
        background: #fff;
        color: #1f2d2b;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 16px;
        line-height: 1.4;
        resize: vertical;
        box-sizing: border-box;
        outline: none;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

        .description-textarea:focus {
            border-color: #17a589;
            box-shadow: 0 0 0 3px rgba(23, 165, 137, 0.15);
        }

    .save-area {
        margin-left: 23px;
        margin-top: 20px;
    }

    .save-button {
        background: #0f5d52;
        color: #fff;
        border: 1px solid #0f5d52;
        border-radius: 6px;
        padding: 7px 15px;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s ease;
    }

        .save-button:hover {
            background: #0c4b42;
            border-color: #0c4b42;
        }

    .validation-message {
        display: block;
        margin-left: 23px;
        margin-top: 3px;
        color: #dc3545;
        font-size: 12px;
    }

    @@media (max-width: 900px) {

        .feedback-edit-card {
            width: 100%;
            padding: 30px 25px 35px 25px;
        }

        .feedback-edit-title {
            font-size: 28px;
        }

        .question-textarea {
            font-size: 15px;
        }

        .answer-area,
        .save-area {
            margin-left: 15px;
        }

        .star {
            font-size: 27px;
        }

        .emoji {
            font-size: 24px;
        }
    }

    @@media (max-width: 500px) {

        .feedback-edit-card {
            padding: 25px 18px 30px 18px;
        }

        .feedback-edit-title {
            font-size: 24px;
        }

        .question-label {
            font-size: 16px;
        }

        .answer-area,
        .save-area {
            margin-left: 10px;
        }

        .star-options {
            gap: 1px;
        }

            .star-options label {
                width: 32px;
            }

        .star {
            font-size: 24px;
        }

        .emoji-options {
            gap: 7px;
        }

            .emoji-options label {
                width: 39px;
                height: 39px;
            }

        .emoji {
            font-size: 21px;
        }
    }
</style>
